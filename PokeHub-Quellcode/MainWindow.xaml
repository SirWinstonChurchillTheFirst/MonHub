<Window x:Class="PokeHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PokeHub"
        Title="MonHub" Width="1200" Height="800" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Hub.Bg}"
        Icon="{StaticResource PokeballImage}" Activated="Window_Activated"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        StateChanged="Window_StateChanged" Deactivated="Window_Deactivated">
    <!--
        The shell: theme decoration behind everything, MonHub's own title bar, the menu (left, or right in the Game Boy
        theme), the pages on the theme's "screen". Pages are created on first use and kept, so switching back is instant.
    -->
    <WindowChrome.WindowChrome>
        <!-- Windows' frame stays (snapping, resizing, shadow, rounded corners on Windows 11) – only its title bar is ours -->
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ContentControl Grid.RowSpan="2" ContentTemplate="{DynamicResource Hub.Backdrop}" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>

        <Grid Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- the menu -->
            <Border x:Name="Rail" Grid.Column="{DynamicResource Hub.RailColumn}" Width="{DynamicResource Hub.RailWidth}"
                    Background="{DynamicResource Hub.Rail}" BorderBrush="{DynamicResource Hub.RailLine}" BorderThickness="{DynamicResource Hub.RailBorder}"
                    Margin="{DynamicResource Hub.RailMargin}" Padding="{DynamicResource Hub.RailTitleInset}" CornerRadius="{DynamicResource Hub.RailRadius}">
                <Border BorderBrush="{DynamicResource Hub.RailInnerLine}" BorderThickness="{DynamicResource Hub.RailInnerBorder}"
                        Margin="{DynamicResource Hub.RailInnerGap}" CornerRadius="{DynamicResource Hub.RadiusInner}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentControl ContentTemplate="{DynamicResource Hub.RailIdentity}" Focusable="False" IsTabStop="False"/>

                        <StackPanel x:Name="Nav" Grid.Row="1" KeyboardNavigation.DirectionalNavigation="Cycle" Margin="0,4,0,0">
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="start" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/play" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Weiter" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="games" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/cartridge" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Spiele" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="run" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/dice" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Neuer Run" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="nuzlocke" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/journal" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Nuzlocke" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="pokedex" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/magnifier" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Dex" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="fangames" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/star" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Fangames" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="emulators" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/console" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Emulatoren" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{DynamicResource Hub.Nav}" GroupName="HubNav" Tag="options" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <local:SpriteView Key="icon/gear" Width="32" Height="32" Margin="-5,-6,7,-6" Visibility="{DynamicResource Hub.NavIconVisibility}"/>
                                    <TextBlock Tag="Optionen" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <ContentControl x:Name="RailDeco" Grid.Row="2" ContentTemplate="{DynamicResource Hub.RailDeco}" Focusable="False" IsTabStop="False"/>

                        <DockPanel Grid.Row="3" Margin="16,2,14,12">
                            <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Foreground="{DynamicResource Hub.RailInkMuted}" FontSize="11"
                                       FontFamily="{DynamicResource Hub.FontLabel}" VerticalAlignment="Center"/>
                            <Button Style="{DynamicResource Hub.RailLink}" Click="Help_Click" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtHelp" Tag="So geht's"/>
                            </Button>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- the pages -->
            <ContentControl Grid.Column="1" Style="{DynamicResource Hub.ScreenFrame}" Margin="0,34,0,0">
                <Grid x:Name="PageHost"/>
            </ContentControl>
        </Grid>

        <!-- the title bar over the top edge: drag to move, double-click to maximize (Windows does that for the free area) -->
        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="BtnMinimize" Style="{StaticResource Chrome.Button}" Click="Minimize_Click" ToolTip="Minimieren" Content="&#xE921;"/>
            <Button x:Name="BtnMaximize" Style="{StaticResource Chrome.Button}" Click="Maximize_Click" Content="&#xE922;"/>
            <Button x:Name="BtnClose" Style="{StaticResource Chrome.Close}" Click="Close_Click" ToolTip="Schließen" Content="&#xE8BB;"/>
        </StackPanel>

        <!-- Porygon's tour, on top of everything but the title bar (closing and moving the window keep working) -->
        <local:TourOverlay x:Name="TourLayer" Grid.Row="1" Visibility="Collapsed"/>
    </Grid>
</Window>
