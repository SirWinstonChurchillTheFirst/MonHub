<!--
    Lavandia: night at the Pokémon Tower. Deep violet sky with a few stars and the moon, the tower's silhouette and low fog
    along the bottom (all still – it lies behind the pages). Surfaces are gravestone-shaped: big round top corners,
    almost square at the bottom. The menu's name plate is a gravestone; at its foot a Gastly floats between two candles
    that flicker (small, low frame rate). Serif type (Constantia, part of Windows) for a storybook feel.
    Pokémon shown are PMD Sprite Collab sprites, nothing drawn by hand.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:PokeHub">

    <!-- night sky: violet with a few faint stars -->
    <DrawingBrush x:Key="Hub.Bg" TileMode="Tile" Viewport="0,0,180,140" ViewportUnits="Absolute" RenderOptions.CachingHint="Cache">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#150D26" Geometry="M0,0 H180 V140 H0 Z"/>
                <GeometryDrawing Brush="#3A2C63">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="23,17" RadiusX="1" RadiusY="1"/>
                            <EllipseGeometry Center="131,41" RadiusX="0.8" RadiusY="0.8"/>
                            <EllipseGeometry Center="72,96" RadiusX="1.1" RadiusY="1.1"/>
                            <EllipseGeometry Center="162,118" RadiusX="0.7" RadiusY="0.7"/>
                            <EllipseGeometry Center="98,8" RadiusX="0.6" RadiusY="0.6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="Hub.Rail" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0E0819" Offset="0"/>
        <GradientStop Color="#1A1030" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hub.RailLine" Color="#2E2150"/>
    <SolidColorBrush x:Key="Hub.RailInk" Color="#DCD0F7"/>
    <SolidColorBrush x:Key="Hub.RailInkMuted" Color="#8C7CB5"/>
    <SolidColorBrush x:Key="Hub.RailHover" Color="#1FB28DFF"/>
    <SolidColorBrush x:Key="Hub.RailSelected" Color="#2C1C4E"/>
    <SolidColorBrush x:Key="Hub.RailSelectedInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.RailCursor" Color="#B28DFF"/>
    <Thickness x:Key="Hub.RailBorder">0,0,1,0</Thickness>
    <sys:Double x:Key="Hub.RailWidth">230</sys:Double>

    <SolidColorBrush x:Key="Hub.Surface" Color="#1E1435"/>
    <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#180F2C"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#26193F"/>
    <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#2D1E4C"/>
    <SolidColorBrush x:Key="Hub.Ink" Color="#E6DCFF"/>
    <SolidColorBrush x:Key="Hub.InkStrong" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.InkMuted" Color="#9C8DC4"/>
    <SolidColorBrush x:Key="Hub.Line" Color="#34265C"/>
    <SolidColorBrush x:Key="Hub.LineStrong" Color="#4B3784"/>
    <SolidColorBrush x:Key="Hub.InsetLine" Color="#2D2150"/>
    <SolidColorBrush x:Key="Hub.Selection" Color="#B28DFF"/>

    <SolidColorBrush x:Key="Hub.Accent" Color="#B28DFF"/>
    <SolidColorBrush x:Key="Hub.AccentEdge" Color="#6B4BC2"/>
    <SolidColorBrush x:Key="Hub.AccentInk" Color="#170D2B"/>
    <SolidColorBrush x:Key="Hub.KeyFace" Color="#2A1D49"/>
    <SolidColorBrush x:Key="Hub.KeyEdge" Color="#0C0717"/>
    <SolidColorBrush x:Key="Hub.KeyInk" Color="#E6DCFF"/>
    <SolidColorBrush x:Key="Hub.KeyLine" Color="#45327A"/>
    <SolidColorBrush x:Key="Hub.HoverOverlay" Color="#18B28DFF"/>
    <SolidColorBrush x:Key="Hub.PressOverlay" Color="#30000000"/>
    <SolidColorBrush x:Key="Hub.Good" Color="#7DF0B6"/>
    <SolidColorBrush x:Key="Hub.Danger" Color="#FF7A9C"/>
    <SolidColorBrush x:Key="Hub.DangerSoft" Color="#26FF7A9C"/>
    <SolidColorBrush x:Key="Hub.DangerFace" Color="#D9466E"/>
    <SolidColorBrush x:Key="Hub.DangerEdge" Color="#7E1E3C"/>
    <SolidColorBrush x:Key="Hub.DangerInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.Dialog" Color="#150D26"/>
    <SolidColorBrush x:Key="Hub.SlotFill" Color="#261B44"/>
    <SolidColorBrush x:Key="Hub.SlotLine" Color="#34265C"/>
    <SolidColorBrush x:Key="Hub.BadgeOn" Color="#FFD36B"/>
    <SolidColorBrush x:Key="Hub.BadgeOff" Color="#34265C"/>
    <SolidColorBrush x:Key="Hub.ChipOn" Color="#B28DFF"/>
    <SolidColorBrush x:Key="Hub.ChipOnInk" Color="#170D2B"/>

    <!-- gravestones: round on top, nearly square at the bottom -->
    <CornerRadius x:Key="Hub.RadiusPanel">22,22,4,4</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusInner">14,14,3,3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusControl">12,12,3,3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusChip">10,10,3,3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCard">16,16,3,3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCheck">6,6,2,2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusSlot">10,10,2,2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusNav">12,12,3,3</CornerRadius>
    <Visibility x:Key="Hub.ShadowVisibility">Collapsed</Visibility>
    <Thickness x:Key="Hub.KeyDepth">0,0,0,2</Thickness>
    <Thickness x:Key="Hub.NavMargin">12,2</Thickness>

    <FontFamily x:Key="Hub.FontDisplay">Constantia, Georgia, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontLabel">Constantia, Georgia, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontNav">Constantia, Georgia, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontValue">Constantia, Georgia, Segoe UI Symbol</FontFamily>
    <FontWeight x:Key="Hub.WeightTitle">Bold</FontWeight>
    <FontWeight x:Key="Hub.WeightLabel">Bold</FontWeight>
    <sys:Double x:Key="Hub.SizeTitle">29</sys:Double>
    <sys:Double x:Key="Hub.SizeLabel">11</sys:Double>
    <sys:Double x:Key="Hub.SizeNav">16</sys:Double>
    <sys:Double x:Key="Hub.SizeValue">16</sys:Double>

    <!-- moon, the tower on the hill and fog along the bottom – everything still -->
    <DataTemplate x:Key="Hub.Backdrop">
        <Grid ClipToBounds="True">
            <Grid Width="190" Height="190" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-105,-95,0" Opacity="0.45">
                <Ellipse Fill="#F4E9FF" Opacity="0.05"/>
                <Ellipse Margin="28" Fill="#F4E9FF" Opacity="0.07"/>
                <Ellipse Margin="48" Fill="#EFE3FF" Opacity="0.55"/>
                <Ellipse Width="16" Height="12" Fill="#D9C8F5" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="66,70,0,0"/>
            </Grid>
            <!-- Pokémon Tower: a stepped silhouette with a spire (no lit windows – they peeked out between list rows) -->
            <Canvas Width="150" Height="230" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,20" Opacity="0.3">
                <Path Fill="#0B0616" Data="M60,0 L66,26 L84,26 L84,60 L98,60 L98,110 L112,110 L112,230 L22,230 L22,110 L36,110 L36,60 L50,60 L50,26 L56,26 Z"/>
            </Canvas>
            <Rectangle Height="120" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00B28DFF" Offset="0"/>
                        <GradientStop Color="#1FB28DFF" Offset="0.7"/>
                        <GradientStop Color="#33C9B5FF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </DataTemplate>

    <!-- name plate: a gravestone -->
    <DataTemplate x:Key="Hub.RailIdentity">
        <Border Margin="22,22,22,16" Padding="16,16,14,12" CornerRadius="40,40,4,4" Background="#2A1E45"
                BorderBrush="#4B3784" BorderThickness="2">
            <DockPanel>
                <local:SpriteView Key="species/0094" Width="38" Height="38" DockPanel.Dock="Right" VerticalAlignment="Center"
                                  Stretch="Uniform"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SPUK" FontFamily="Constantia" FontWeight="Bold" FontSize="10.5" Foreground="#B28DFF"/>
                    <TextBlock Text="MonHub" FontFamily="Constantia" FontWeight="Bold" FontSize="23" Foreground="#FFFFFF"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- at the foot of the menu: a Gastly floats between two flickering candles -->
    <DataTemplate x:Key="Lavandia.Candle">
        <Canvas Width="14" Height="40">
            <Rectangle Canvas.Left="3" Canvas.Top="16" Width="8" Height="24" RadiusX="2" RadiusY="2" Fill="#E9DEC8"/>
            <Rectangle Canvas.Left="6.5" Canvas.Top="11" Width="1" Height="6" Fill="#3A2C20"/>
            <Ellipse Canvas.Left="2" Canvas.Top="0" Width="10" Height="14" Fill="#FFB84D" Opacity="0.35"/>
            <Path Canvas.Left="3.5" Canvas.Top="2" Fill="#FFD36B" Data="M3.5,0 C5.5,3 7,6 7,8.5 C7,10.5 5.4,12 3.5,12 C1.6,12 0,10.5 0,8.5 C0,6 1.5,3 3.5,0 Z"
                  RenderTransformOrigin="0.5,1">
                <Path.RenderTransform>
                    <ScaleTransform/>
                </Path.RenderTransform>
                <local:Ambient.Storyboard>
                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="8">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" Duration="0:0:1.6">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1.15"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.9"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="1.08"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="0.95"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </local:Ambient.Storyboard>
            </Path>
        </Canvas>
    </DataTemplate>
    <DataTemplate x:Key="Hub.RailDeco">
        <Grid Margin="30,0,30,10" Height="62">
            <ContentControl ContentTemplate="{DynamicResource Lavandia.Candle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Focusable="False"/>
            <ContentControl ContentTemplate="{DynamicResource Lavandia.Candle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Focusable="False"/>
            <local:SpriteView Key="species/0092" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Stretch="Uniform" Decorative="True">
                <local:SpriteView.RenderTransform>
                    <TranslateTransform/>
                </local:SpriteView.RenderTransform>
                <local:Ambient.Storyboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="12">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="10" Duration="0:0:2.4">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </local:Ambient.Storyboard>
            </local:SpriteView>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
