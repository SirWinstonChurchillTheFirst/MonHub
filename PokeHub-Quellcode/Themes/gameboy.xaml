<!--
    Game Boy: the window is the green screen. Only the four shades of the original LCD (sprites are recoloured too),
    a faint dot matrix, text boxes with double lines, pixel type, no shadows. The menu is the in-game START menu on
    the right: a text box, entries in capitals, a blinking pixel ▶ at the current one and a hollow one where the
    mouse is.
      #0F380F darkest · #306230 dark · #8BAC0F light · #9BBC0F lightest
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:PokeHub">

    <!-- dot matrix: a slightly darker line every 4 pixels -->
    <DrawingBrush x:Key="Hub.Bg" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" RenderOptions.CachingHint="Cache">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#8BAC0F" Geometry="M0,0 H4 V4 H0 Z"/>
                <GeometryDrawing Brush="#84A40E" Geometry="M3,0 H4 V4 H3 Z M0,3 H3 V4 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="Hub.Rail" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.RailLine" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.RailInnerLine" Color="#306230"/>
    <SolidColorBrush x:Key="Hub.RailInk" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.RailInkMuted" Color="#306230"/>
    <SolidColorBrush x:Key="Hub.RailHover" Color="Transparent"/>
    <SolidColorBrush x:Key="Hub.RailSelected" Color="Transparent"/>
    <SolidColorBrush x:Key="Hub.RailSelectedInk" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.RailCursor" Color="#0F380F"/>
    <sys:Int32 x:Key="Hub.RailColumn">2</sys:Int32>
    <sys:Double x:Key="Hub.RailWidth">226</sys:Double>
    <Thickness x:Key="Hub.RailBorder">3</Thickness>
    <Thickness x:Key="Hub.RailMargin">0,40,16,16</Thickness>
    <!-- the framed menu box starts below the title bar instead -->
    <Thickness x:Key="Hub.RailTitleInset">0</Thickness>
    <CornerRadius x:Key="Hub.RailRadius">4</CornerRadius>
    <Thickness x:Key="Hub.RailInnerBorder">1</Thickness>
    <Thickness x:Key="Hub.RailInnerGap">3</Thickness>
    <Visibility x:Key="Hub.NavIconVisibility">Collapsed</Visibility>
    <sys:Boolean x:Key="Hub.NavCaps">True</sys:Boolean>
    <Thickness x:Key="Hub.ScreenMargin">4,0,0,0</Thickness>

    <SolidColorBrush x:Key="Hub.Surface" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#8BAC0F"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#8BAC0F"/>
    <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.Ink" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.InkStrong" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.InkMuted" Color="#306230"/>
    <SolidColorBrush x:Key="Hub.Line" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.LineStrong" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.InnerLine" Color="#306230"/>
    <SolidColorBrush x:Key="Hub.InsetLine" Color="#306230"/>
    <SolidColorBrush x:Key="Hub.Selection" Color="#0F380F"/>

    <SolidColorBrush x:Key="Hub.Accent" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.AccentEdge" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.AccentInk" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.KeyFace" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.KeyEdge" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.KeyInk" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.KeyLine" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.HoverOverlay" Color="#40306230"/>
    <SolidColorBrush x:Key="Hub.PressOverlay" Color="#70306230"/>
    <SolidColorBrush x:Key="Hub.Good" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.Danger" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.DangerSoft" Color="#8BAC0F"/>
    <SolidColorBrush x:Key="Hub.DangerFace" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.DangerEdge" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.DangerInk" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.Dialog" Color="#8BAC0F"/>
    <SolidColorBrush x:Key="Hub.SlotFill" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.SlotLine" Color="#306230"/>
    <SolidColorBrush x:Key="Hub.BadgeOn" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.BadgeOff" Color="#9BBC0F"/>
    <SolidColorBrush x:Key="Hub.ChipOn" Color="#0F380F"/>
    <SolidColorBrush x:Key="Hub.ChipOnInk" Color="#9BBC0F"/>

    <CornerRadius x:Key="Hub.RadiusPanel">4</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusInner">1</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusControl">3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusChip">2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCard">3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCheck">1</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusSlot">2</CornerRadius>
    <Thickness x:Key="Hub.PanelBorder">3</Thickness>
    <Thickness x:Key="Hub.InnerBorder">1</Thickness>
    <Thickness x:Key="Hub.InnerGap">3</Thickness>
    <Thickness x:Key="Hub.CardBorder">2</Thickness>
    <Thickness x:Key="Hub.SelectionBorder">3</Thickness>
    <Visibility x:Key="Hub.ShadowVisibility">Collapsed</Visibility>
    <Thickness x:Key="Hub.KeyDepth">0,0,0,3</Thickness>
    <Thickness x:Key="Hub.KeyBorder">2</Thickness>

    <FontFamily x:Key="Hub.FontDisplay">pack://application:,,,/Assets/Fonts/#Press Start 2P, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontLabel">pack://application:,,,/Assets/Fonts/#Press Start 2P, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontBody">pack://application:,,,/Assets/Fonts/#Pixelify Sans, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontNav">pack://application:,,,/Assets/Fonts/#Press Start 2P, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontValue">pack://application:,,,/Assets/Fonts/#Pixelify Sans, Segoe UI Symbol</FontFamily>
    <sys:Double x:Key="Hub.SizeTitle">18</sys:Double>
    <sys:Double x:Key="Hub.SizeHeading">13</sys:Double>
    <sys:Double x:Key="Hub.SizeLabel">8</sys:Double>
    <sys:Double x:Key="Hub.SizeNav">12</sys:Double>
    <sys:Double x:Key="Hub.SizeValue">16</sys:Double>
    <sys:Double x:Key="Hub.SizeTag">8</sys:Double>
    <FontWeight x:Key="Hub.WeightTitle">Normal</FontWeight>
    <FontWeight x:Key="Hub.WeightLabel">Normal</FontWeight>

    <!-- START menu entry: blinking ▶ at the current page, hollow ▷ under the mouse -->
    <Style x:Key="Hub.Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#0F380F"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontNav}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeNav}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Padding="6,10" Margin="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Hollow" Data="M0,0 H2 V2 H4 V4 H6 V6 H8 V8 H6 V10 H4 V12 H2 V14 H0 Z" Stroke="#306230" StrokeThickness="1.5"
                                  VerticalAlignment="Center" Visibility="Hidden"/>
                            <Path x:Name="Cursor" Data="M0,0 H2 V2 H4 V4 H6 V6 H8 V8 H6 V10 H4 V12 H2 V14 H0 Z" Fill="#0F380F"
                                  VerticalAlignment="Center" Visibility="Hidden">
                                <local:Ambient.Storyboard>
                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="4">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </local:Ambient.Storyboard>
                            </Path>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Cursor" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Hollow" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hub.NavAction" TargetType="Button">
        <Setter Property="Foreground" Value="#0F380F"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontNav}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeNav}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="6,10" Margin="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Hollow" Data="M0,0 H2 V2 H4 V4 H6 V6 H8 V8 H6 V10 H4 V12 H2 V14 H0 Z" Stroke="#306230" StrokeThickness="1.5"
                                  VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hollow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hollow" Property="Fill" Value="#0F380F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a game in the list: a text box; the selected one gets the ▶ in front and a heavier frame -->
    <Style x:Key="Hub.Card" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="22,0,4,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="#9BBC0F" BorderBrush="#0F380F" BorderThickness="2" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <Path x:Name="Cursor" Data="M0,0 H2 V2 H4 V4 H6 V6 H8 V8 H6 V10 H4 V12 H2 V14 H0 Z" Fill="#0F380F"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-18,0,0,0" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8BAC0F"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3"/>
                            <Setter TargetName="Bd" Property="Background" Value="#9BBC0F"/>
                            <Setter TargetName="Cursor" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Hub.RailIdentity">
        <StackPanel Margin="16,14,14,8">
            <StackPanel Orientation="Horizontal">
                <local:SpriteView Key="icon/console" Width="32" Height="32" Margin="-4,0,6,0"/>
                <TextBlock Text="MONHUB" FontFamily="{DynamicResource Hub.FontDisplay}" FontSize="12" Foreground="#0F380F" VerticalAlignment="Center"/>
            </StackPanel>
            <Rectangle Height="2" Fill="#306230" Margin="0,10,0,4"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
