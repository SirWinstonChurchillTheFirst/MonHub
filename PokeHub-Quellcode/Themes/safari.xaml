<!--
    Safari-Zone: outdoors. Sand with little stones, the menu is a wooden board with a paper note pinned on it, the current
    page is a paper tab, content lies on parchment signs with a hard brown shadow, grass sways along the bottom edge.
    Serif headings like a ranger's notebook.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:PokeHub">

    <!-- sand -->
    <DrawingBrush x:Key="Hub.Bg" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute" RenderOptions.CachingHint="Cache">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#EFE3C2" Geometry="M0,0 H64 V64 H0 Z"/>
                <GeometryDrawing Brush="#E2D0A2">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="9,12" RadiusX="1.6" RadiusY="1.2"/>
                            <EllipseGeometry Center="37,43" RadiusX="1.3" RadiusY="1"/>
                            <EllipseGeometry Center="53,19" RadiusX="1.1" RadiusY="0.9"/>
                            <EllipseGeometry Center="21,55" RadiusX="1.5" RadiusY="1.1"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- wooden planks -->
    <DrawingBrush x:Key="Hub.Rail" TileMode="Tile" Viewport="0,0,240,40" ViewportUnits="Absolute" RenderOptions.CachingHint="Cache">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#8A5A2E" Geometry="M0,0 H240 V40 H0 Z"/>
                <GeometryDrawing Brush="#9A6836" Geometry="M0,0 H240 V1.5 H0 Z"/>
                <GeometryDrawing Brush="#5A3818" Geometry="M0,38 H240 V40 H0 Z"/>
                <GeometryDrawing Brush="#7A4E27" Geometry="M12,12 H100 V13.5 H12 Z M130,24 H226 V25.5 H130 Z M40,30 H82 V31 H40 Z"/>
                <GeometryDrawing Brush="#6E451F">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="196,14" RadiusX="4" RadiusY="2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="Hub.RailLine" Color="#5A3818"/>
    <SolidColorBrush x:Key="Hub.RailInk" Color="#FFF3D6"/>
    <SolidColorBrush x:Key="Hub.RailInkMuted" Color="#E6CFA2"/>
    <SolidColorBrush x:Key="Hub.RailHover" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Hub.RailSelected" Color="#F4E3B5"/>
    <SolidColorBrush x:Key="Hub.RailSelectedInk" Color="#3A2A18"/>
    <SolidColorBrush x:Key="Hub.RailCursor" Color="#3A2A18"/>
    <Thickness x:Key="Hub.RailBorder">0,0,3,0</Thickness>
    <sys:Double x:Key="Hub.RailWidth">230</sys:Double>

    <SolidColorBrush x:Key="Hub.Surface" Color="#FFF8E6"/>
    <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#F7EBCD"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#FFFBEF"/>
    <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#FFFCF3"/>
    <SolidColorBrush x:Key="Hub.Ink" Color="#3A2A18"/>
    <SolidColorBrush x:Key="Hub.InkStrong" Color="#2A1C0E"/>
    <SolidColorBrush x:Key="Hub.InkMuted" Color="#86704F"/>
    <SolidColorBrush x:Key="Hub.Line" Color="#8A5A2E"/>
    <SolidColorBrush x:Key="Hub.LineStrong" Color="#8A5A2E"/>
    <SolidColorBrush x:Key="Hub.InsetLine" Color="#D8C394"/>
    <SolidColorBrush x:Key="Hub.Selection" Color="#4E9A37"/>

    <SolidColorBrush x:Key="Hub.Accent" Color="#4E9A37"/>
    <SolidColorBrush x:Key="Hub.AccentEdge" Color="#2F6B1F"/>
    <SolidColorBrush x:Key="Hub.AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.KeyFace" Color="#F4E3B5"/>
    <SolidColorBrush x:Key="Hub.KeyEdge" Color="#8A5A2E"/>
    <SolidColorBrush x:Key="Hub.KeyInk" Color="#3A2A18"/>
    <SolidColorBrush x:Key="Hub.KeyLine" Color="#8A5A2E"/>
    <SolidColorBrush x:Key="Hub.HoverOverlay" Color="#148A5A2E"/>
    <SolidColorBrush x:Key="Hub.PressOverlay" Color="#268A5A2E"/>
    <SolidColorBrush x:Key="Hub.Good" Color="#3E8A2B"/>
    <SolidColorBrush x:Key="Hub.Danger" Color="#B8361F"/>
    <SolidColorBrush x:Key="Hub.DangerSoft" Color="#1FB8361F"/>
    <SolidColorBrush x:Key="Hub.DangerFace" Color="#B8361F"/>
    <SolidColorBrush x:Key="Hub.DangerEdge" Color="#7A2212"/>
    <SolidColorBrush x:Key="Hub.DangerInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.Dialog" Color="#EFE3C2"/>
    <SolidColorBrush x:Key="Hub.Shadow" Color="#4D5A3818"/>
    <SolidColorBrush x:Key="Hub.SlotFill" Color="#F7EBCD"/>
    <SolidColorBrush x:Key="Hub.SlotLine" Color="#D8C394"/>
    <SolidColorBrush x:Key="Hub.BadgeOn" Color="#D99A1E"/>
    <SolidColorBrush x:Key="Hub.BadgeOff" Color="#E2D2A6"/>
    <SolidColorBrush x:Key="Hub.ChipOn" Color="#3A2A18"/>
    <SolidColorBrush x:Key="Hub.ChipOnInk" Color="#FFF3D6"/>

    <CornerRadius x:Key="Hub.RadiusPanel">4</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusInner">3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusChip">4</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCard">4</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusSlot">3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusNav">3</CornerRadius>
    <Thickness x:Key="Hub.PanelBorder">2</Thickness>
    <Thickness x:Key="Hub.CardBorder">2</Thickness>
    <Thickness x:Key="Hub.ShadowOffset">4,4,-4,-4</Thickness>
    <Thickness x:Key="Hub.KeyDepth">0,0,0,3</Thickness>
    <Thickness x:Key="Hub.KeyBorder">2</Thickness>
    <Thickness x:Key="Hub.NavMargin">12,2</Thickness>
    <Visibility x:Key="Hub.IndicatorVisibility">Collapsed</Visibility>

    <FontFamily x:Key="Hub.FontDisplay">Georgia, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontLabel">Georgia, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontNav">Georgia, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontValue">Georgia, Segoe UI Symbol</FontFamily>
    <FontWeight x:Key="Hub.WeightTitle">Bold</FontWeight>
    <FontWeight x:Key="Hub.WeightLabel">Bold</FontWeight>
    <FontWeight x:Key="Hub.WeightNav">Bold</FontWeight>
    <sys:Double x:Key="Hub.SizeTitle">28</sys:Double>
    <sys:Double x:Key="Hub.SizeLabel">10.5</sys:Double>
    <sys:Double x:Key="Hub.SizeNav">15</sys:Double>
    <sys:Double x:Key="Hub.CardTilt">-1.5</sys:Double>

    <!-- grass along the bottom, swaying a little in the wind -->
    <DrawingBrush x:Key="Safari.Grass" TileMode="Tile" Viewport="0,0,96,46" ViewportUnits="Absolute" RenderOptions.CachingHint="Cache">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00000000" Geometry="M0,0 H96 V46 H0 Z"/>
                <GeometryDrawing Brush="#3F7F2C" Geometry="M0,46 L7,14 L12,46 Z M30,46 L38,6 L44,46 Z M62,46 L68,18 L74,46 Z"/>
                <GeometryDrawing Brush="#6DB33F" Geometry="M10,46 L18,20 L22,46 Z M44,46 L52,12 L58,46 Z M76,46 L85,22 L90,46 Z M88,46 L93,28 L96,46 Z M20,46 L25,30 L30,46 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- a gust now and then (4 s of 10), not a constant sway: the strip lies behind the page, and while it moves
         a PC without graphics card redraws that strip with everything on top of it -->
    <DataTemplate x:Key="Hub.Backdrop">
        <Rectangle Height="46" VerticalAlignment="Bottom" Fill="{DynamicResource Safari.Grass}" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <SkewTransform/>
            </Rectangle.RenderTransform>
            <local:Ambient.Storyboard>
                <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="12">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(SkewTransform.AngleX)" Duration="0:0:10">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:1.2" Value="4" KeySpline="0.4,0,0.6,1"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="-2" KeySpline="0.4,0,0.6,1"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:3.4" Value="1" KeySpline="0.4,0,0.6,1"/>
                        <SplineDoubleKeyFrame KeyTime="0:0:4.2" Value="0" KeySpline="0.4,0,0.6,1"/>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </local:Ambient.Storyboard>
        </Rectangle>
    </DataTemplate>

    <!-- a paper note pinned to the board -->
    <DataTemplate x:Key="Hub.RailIdentity">
        <Grid Margin="18,22,18,16">
            <Border Background="#F4E3B5" BorderBrush="#5A3818" BorderThickness="2" CornerRadius="3" Padding="14,10,12,10" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="-2.5"/>
                </Border.RenderTransform>
                <DockPanel>
                    <local:SpriteView Key="icon/paw" Width="32" Height="32" DockPanel.Dock="Right" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="{local:L 'SAVANNE', 'SAVANNA'}" FontFamily="Georgia" FontWeight="Bold" FontSize="10.5" Foreground="#4E9A37"/>
                        <TextBlock Text="MonHub" FontFamily="Georgia" FontWeight="Bold" FontSize="23" Foreground="#2A1C0E"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Ellipse Width="7" Height="7" Fill="#3A2A18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4,0,0"/>
            <Ellipse Width="7" Height="7" Fill="#3A2A18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,10,0"/>
        </Grid>
    </DataTemplate>

    <!-- at the foot of the board: the ball counter on a note, a Tauros next to it -->
    <DataTemplate x:Key="Hub.RailDeco">
        <Grid Margin="16,0,16,12">
            <Border Background="#F4E3B5" BorderBrush="#5A3818" BorderThickness="2" CornerRadius="3" Padding="10,6,10,6"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="2"/>
                </Border.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <local:SpriteView Key="icon/paw" Width="32" Height="32" VerticalAlignment="Center"/>
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="{local:L 'HERDE', 'HERD'}" FontFamily="Georgia" FontWeight="Bold" FontSize="9" Foreground="#4E9A37"/>
                        <TextBlock Text="× 30" FontFamily="Georgia" FontWeight="Bold" FontSize="15" Foreground="#2A1C0E"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <local:SpriteView Key="species/0128" Width="58" Height="58" HorizontalAlignment="Right" VerticalAlignment="Bottom" Decorative="True"
                              Stretch="Uniform"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
