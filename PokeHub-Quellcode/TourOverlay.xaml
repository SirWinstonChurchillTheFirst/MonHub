<UserControl x:Class="PokeHub.TourOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PokeHub"
             Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle">
    <!--
        Porygon's tour – one focus at a time: the app stays visible under a light shade, the explained part gets a
        calm frame, and a card sits next to it (below, above or beside, wherever it covers nothing) with a small tip
        pointing at it. Porygon is a small avatar on the card.
        Performance: nothing here animates on its own. A step change sets positions once (no layout passes forced, no
        geometry animated) and fades the light and the card in with opacity/transform only.
    -->
    <Grid>
        <!-- takes every click: while the tour is open, the page below is only shown -->
        <Rectangle Fill="Transparent"/>

        <Grid x:Name="Light" IsHitTestVisible="False">
            <Path x:Name="Shade" Fill="#66000000"/>
            <Canvas>
                <!-- the frame: a clear line with a soft edge, no glow show -->
                <Border x:Name="FrameSoft" BorderBrush="{DynamicResource Hub.Accent}" BorderThickness="6" CornerRadius="14" Opacity="0.18"/>
                <Border x:Name="FrameLine" BorderBrush="{DynamicResource Hub.Accent}" BorderThickness="2" CornerRadius="11"/>
            </Canvas>
        </Grid>

        <Canvas x:Name="CardLayer">
            <Grid x:Name="Card" Width="380">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CardShift"/>
                </Grid.RenderTransform>
                <!-- the tip toward the highlighted part: a small turned square in the card's colours, half hidden under it -->
                <Border x:Name="Tip" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Accent}" BorderThickness="1.5"
                        RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Border.RenderTransform>
                </Border>
                <Border x:Name="CardBody" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Accent}"
                        BorderThickness="1.5" CornerRadius="{DynamicResource Hub.RadiusPanel}" Padding="18,14,18,16">
                    <StackPanel>
                        <!-- who talks, how far, and the way out – always at the same place -->
                        <DockPanel>
                            <!-- a Border's CornerRadius doesn't clip its child: the face is cut round itself, the ring drawn on top -->
                            <Grid Width="40" Height="40" DockPanel.Dock="Left" Margin="0,0,10,0">
                                <Ellipse Fill="{DynamicResource Hub.SlotFill}"/>
                                <local:SpriteView x:Name="Face" Width="40" Height="40" Stretch="UniformToFill" Still="True" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <local:SpriteView.Clip>
                                        <EllipseGeometry Center="20,20" RadiusX="19" RadiusY="19"/>
                                    </local:SpriteView.Clip>
                                </local:SpriteView>
                                <Ellipse Stroke="{DynamicResource Hub.Accent}" StrokeThickness="1.5"/>
                            </Grid>
                            <Button x:Name="BtnSkip" DockPanel.Dock="Right" Style="{DynamicResource Hub.Ghost}" Padding="8,3" FontSize="12"
                                    VerticalAlignment="Top" Margin="8,-4,-8,0" Click="Skip_Click" ToolTip="Esc">Tour überspringen</Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PORYGON" Style="{DynamicResource Hub.Label}" FontSize="10"/>
                                <TextBlock x:Name="TxtStep" Style="{DynamicResource Hub.Muted}" FontSize="11.5" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="Track" Height="3" CornerRadius="1.5" Margin="0,10,0,0" Background="{DynamicResource Hub.SlotFill}">
                            <Border x:Name="TrackFill" HorizontalAlignment="Left" CornerRadius="1.5" Background="{DynamicResource Hub.Accent}"/>
                        </Border>

                        <TextBlock x:Name="TxtTitle" Style="{DynamicResource Hub.Heading}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtBody" Style="{DynamicResource Hub.Body}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"/>

                        <DockPanel Margin="0,16,0,0" LastChildFill="False">
                            <Button x:Name="BtnBack" DockPanel.Dock="Left" Style="{DynamicResource Hub.Ghost}" Click="Back_Click" Padding="10,6">Zurück</Button>
                            <Button x:Name="BtnNext" DockPanel.Dock="Right" Style="{DynamicResource Hub.PrimaryKey}" Click="Next_Click" MinWidth="128" MinHeight="38">Weiter →</Button>
                            <Button x:Name="BtnSecond" DockPanel.Dock="Right" Style="{DynamicResource Hub.Ghost}" Click="Second_Click" Margin="0,0,8,0" Padding="10,6" Visibility="Collapsed"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
