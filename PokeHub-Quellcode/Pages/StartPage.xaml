<UserControl x:Class="PokeHub.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PokeHub">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,8,30,28">

            <!-- greeting -->
            <TextBlock x:Name="TxtKicker" Text="WEITER" Style="{DynamicResource Hub.Label}"/>
            <TextBlock x:Name="TxtGreeting" Style="{DynamicResource Hub.Title}" Margin="0,4,0,2"/>
            <TextBlock x:Name="TxtSubline" Style="{DynamicResource Hub.Muted}"/>

            <!-- ===== first start: nothing to play yet ===== -->
            <ContentControl x:Name="Onboarding" Style="{DynamicResource Hub.Panel}" Margin="0,22,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:SpriteView Key="0143/sleep" Height="96" VerticalAlignment="Top" Margin="0,4,24,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Noch ist es ruhig hier." Style="{DynamicResource Hub.Heading}"/>
                        <TextBlock Style="{DynamicResource Hub.Muted}" Margin="0,4,0,14"
                                   Text="Leg deine eigenen ROMs in den MonHub – oder hol sie samt Spielständen von deinem bisherigen Emulator. Danach landet hier dein Abenteuer."/>
                        <WrapPanel>
                            <Button Style="{DynamicResource Hub.PrimaryKey}" Click="Import_Click" Margin="0,0,10,8">Vom Emulator importieren</Button>
                            <Button Style="{DynamicResource Hub.Key}" Click="OpenRoms_Click" Margin="0,0,10,8">ROM-Ordner öffnen</Button>
                             <Button Style="{DynamicResource Hub.Key}" Click="NeuerRun_Click" Margin="0,0,10,8">Neuer Run</Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- ===== continue + trainer card ===== -->
            <Grid x:Name="Hero" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="TrainerGap" Width="20"/>
                    <ColumnDefinition x:Name="TrainerColumn" Width="292"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- the in-game "continue" screen, with the real save -->
                <ContentControl x:Name="ContinuePanel" Style="{DynamicResource Hub.Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- box Pokémon on the version colour -->
                            <Border CornerRadius="{DynamicResource Hub.RadiusInner}" Background="{Binding Card.AccentGlow}" MinHeight="156">
                                <Grid>
                                    <local:SpriteView Key="{Binding Card.Sprite}" MaxHeight="124" MaxWidth="150" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,22"/>
                                    <Border Background="{Binding Card.AccentSolid}" CornerRadius="3" Padding="7,2" Margin="8"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding Card.VersionVisibility}">
                                        <TextBlock Text="{Binding Card.Version}" FontFamily="{DynamicResource Hub.FontLabel}" FontSize="{DynamicResource Hub.SizeTag}" Foreground="{Binding Card.AccentInk}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ContentControl Grid.Column="2" Style="{DynamicResource Hub.Inset}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Kicker}" Style="{DynamicResource Hub.Label}" Foreground="{DynamicResource Hub.Accent}"/>
                                    <TextBlock Text="{Binding Card.Name}" Style="{DynamicResource Hub.Heading}" Margin="0,2,0,12" ToolTip="{Binding Card.Game.Rom}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="SPIELER" Style="{DynamicResource Hub.Label}" VerticalAlignment="Center" Margin="0,0,24,6"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Player}" Style="{DynamicResource Hub.Value}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="1" Text="SPIELZEIT" Style="{DynamicResource Hub.Label}" VerticalAlignment="Center" Margin="0,0,24,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Time}" Style="{DynamicResource Hub.Value}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                        <TextBlock Grid.Row="2" Text="ORDEN" Style="{DynamicResource Hub.Label}" VerticalAlignment="Center" Margin="0,0,24,6"/>
                                        <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Badges}" ItemTemplate="{DynamicResource Hub.BadgeTemplate}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,6" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Grid.Row="3" Text="DEX" Style="{DynamicResource Hub.Label}" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Dex}" Style="{DynamicResource Hub.Value}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>
                        </Grid>

                        <!-- the team -->
                        <DockPanel Margin="0,16,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="TEAM" Style="{DynamicResource Hub.Label}" Margin="0,0,0,6"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding TeamHint}" Style="{DynamicResource Hub.Muted}" Visibility="{Binding TeamHintVisibility}"/>
                            <ItemsControl ItemsSource="{Binding Card.Team}" ItemTemplate="{DynamicResource Hub.TeamSlotTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>

                        <!-- go -->
                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="BtnContinue" Style="{DynamicResource Hub.PrimaryKey}" Click="Continue_Click" Margin="0,0,14,0">
                                <TextBlock Text="{Binding ButtonText}"/>
                            </Button>
                            <TextBlock Text="{Binding Note}" Style="{DynamicResource Hub.Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,14,0"/>
                            <Button Style="{DynamicResource Hub.Ghost}" Click="OtherGame_Click" VerticalAlignment="Center">Anderes Spiel …</Button>
                        </WrapPanel>
                    </StackPanel>
                </ContentControl>

                <!-- trainer card -->
                <ContentControl x:Name="TrainerPanel" Grid.Column="2" Style="{DynamicResource Hub.Panel}" VerticalAlignment="Top" Margin="0,14,0,0"
                                RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <RotateTransform Angle="{DynamicResource Hub.CardTilt}"/>
                    </ContentControl.RenderTransform>
                    <StackPanel>
                        <DockPanel>
                            <local:SpriteView Key="icon/card" DockPanel.Dock="Right" Width="32" Height="32" VerticalAlignment="Top"/>
                            <TextBlock Text="TRAINERPASS" Style="{DynamicResource Hub.Label}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Name}" Style="{DynamicResource Hub.Title}" FontSize="22" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding IdLine}" Style="{DynamicResource Hub.Muted}" Margin="0,0,0,12"/>
                        <Border Style="{DynamicResource Hub.Divider}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,7">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{DynamicResource Hub.Value}" FontSize="14"/>
                                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Hub.Label}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Footnote}" Style="{DynamicResource Hub.Muted}" FontSize="11.5" Margin="0,6,0,0"/>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- ===== recent saves ===== -->
            <StackPanel x:Name="RecentSection" Margin="0,26,0,0">
                <TextBlock Text="ZULETZT GESPIELT" Style="{DynamicResource Hub.Label}" Margin="0,0,0,6"/>
                <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{DynamicResource Hub.Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseWheel="List_PreviewMouseWheel" SelectionChanged="Recent_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:GameCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="40" CornerRadius="{DynamicResource Hub.RadiusSlot}" Background="{Binding AccentSoft}">
                                    <local:SpriteView Key="{Binding Sprite}" Still="True" MaxWidth="40" MaxHeight="36" Stretch="Uniform" StretchDirection="DownOnly"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Hub.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TrainerLine}" Style="{DynamicResource Hub.Muted}" FontSize="12" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Team}" ItemTemplate="{DynamicResource Hub.TeamMiniTemplate}"
                                              VerticalAlignment="Center" Margin="0,0,16,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="96">
                                    <TextBlock Text="{Binding SaveTime}" Style="{DynamicResource Hub.Body}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding SaveEmulator}" Style="{DynamicResource Hub.Muted}" FontSize="11.5" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- ===== new adventure ===== -->
            <ContentControl Style="{DynamicResource Hub.Inset}" Margin="0,26,0,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="StarterRow" VerticalAlignment="Bottom" Margin="0,0,18,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:SpriteView Key="{Binding}" Decorative="True" MaxHeight="46" Stretch="Uniform" StretchDirection="DownOnly"
                                                  VerticalAlignment="Bottom" Margin="0,0,4,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Neues Abenteuer" Style="{DynamicResource Hub.Heading}"/>
                        <TextBlock x:Name="TxtStarterLine" Style="{DynamicResource Hub.Muted}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{DynamicResource Hub.Key}" Click="NeuerRun_Click" VerticalAlignment="Center">Neuer Run</Button>
                </Grid>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
