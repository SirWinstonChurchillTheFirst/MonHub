<UserControl x:Class="PokeHub.PokedexPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PokeHub">
    <!--
        The Dex of one save, read straight from it: every Pokémon the game knows, by national number – caught ones
        with their sprite and a Poké Ball, seen ones faded, unknown ones as "?".
        Performance: rows of cells in a virtualizing list (only the visible rows exist), sprites stand still.
    -->
    <Grid Margin="30,8,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: title + search -->
        <DockPanel>
            <Grid DockPanel.Dock="Right" Width="230" VerticalAlignment="Bottom" Margin="16,0,0,4">
                <TextBox x:Name="TxtSearch" Style="{DynamicResource Hub.Search}" TextChanged="Search_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="11,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Hub.InkMuted}" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="Name oder Nummer …" Margin="31,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource Hub.Muted}" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel>
                <TextBlock Text="DEX" Style="{DynamicResource Hub.Label}"/>
                <TextBlock Text="Dex" Style="{DynamicResource Hub.Title}" Margin="0,4,0,2"/>
                <TextBlock x:Name="TxtSummary" Style="{DynamicResource Hub.Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- which save, which Pokémon -->
        <WrapPanel x:Name="FilterBar" Grid.Row="1" Margin="0,16,0,4">
            <ComboBox x:Name="CmbSave" MinWidth="260" MaxWidth="400" Margin="0,0,14,8" SelectionChanged="Save_Changed"
                      ToolTip="Wessen Dex – jeder Spielstand hat seinen eigenen"/>
            <RadioButton x:Name="FilterAll" Style="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" IsChecked="True" Checked="Filter_Changed">
                <TextBlock x:Name="TxtFilterAll" Text="Alle"/>
            </RadioButton>
            <RadioButton x:Name="FilterCaught" Style="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" Checked="Filter_Changed">
                <TextBlock x:Name="TxtFilterCaught" Text="Gefangen"/>
            </RadioButton>
            <RadioButton x:Name="FilterSeen" Style="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" Checked="Filter_Changed">
                <TextBlock x:Name="TxtFilterSeen" Text="Nur gesehen"/>
            </RadioButton>
            <RadioButton x:Name="FilterMissing" Style="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" Checked="Filter_Changed">
                <TextBlock x:Name="TxtFilterMissing" Text="Fehlen"/>
            </RadioButton>
        </WrapPanel>

        <!-- how far: caught of all -->
        <Grid x:Name="ProgressRow" Grid.Row="2" Margin="0,2,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" VerticalAlignment="Center" Maximum="1"/>
            <TextBlock x:Name="TxtProgress" Grid.Column="1" Style="{DynamicResource Hub.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <ListBox x:Name="DexRows" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="Rows_SizeChanged"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <!-- rows are only a layout aid: no selection, no hover -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DexCell}">
                                <Border Style="{DynamicResource Hub.Slot}" Width="{x:Static local:DexCell.Width}" Height="{x:Static local:DexCell.Height}"
                                        Margin="0,0,8,8" ToolTip="{Binding Tooltip}" Opacity="{Binding Fade}">
                                    <Grid>
                                        <TextBlock Text="{Binding NumberText}" Margin="7,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   FontFamily="{DynamicResource Hub.FontLabel}" FontSize="10" Foreground="{DynamicResource Hub.InkMuted}"/>
                                        <local:SpriteView Key="icon/check" Width="16" Height="16" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Still="True" Visibility="{Binding BallVisibility}"/>
                                        <!-- the game sprites are small: shown 1.6× with hard pixels -->
                                        <local:SpriteView Key="{Binding Sprite}" Still="True" MaxWidth="52" MaxHeight="40" Stretch="Uniform" StretchDirection="DownOnly"
                                                          RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,16">
                                            <local:SpriteView.LayoutTransform>
                                                <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                                            </local:SpriteView.LayoutTransform>
                                        </local:SpriteView>
                                        <TextBlock Text="?" Visibility="{Binding UnknownVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14"
                                                   FontFamily="{DynamicResource Hub.FontLabel}" FontSize="26" Foreground="{DynamicResource Hub.InkMuted}"/>
                                        <TextBlock Text="{Binding Name}" Margin="4,0,4,5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                   FontSize="11.5" Foreground="{DynamicResource Hub.Ink}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- nothing to show -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
            <local:SpriteView Key="species/0137" Height="64" Decorative="True" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtEmpty" Style="{DynamicResource Hub.Body}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
