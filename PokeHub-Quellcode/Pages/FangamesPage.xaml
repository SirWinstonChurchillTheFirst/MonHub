<UserControl x:Class="PokeHub.FangamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PokeHub">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,8,30,28">
            <DockPanel>
                <local:SpriteView Key="species/0235" DockPanel.Dock="Right" Height="64" VerticalAlignment="Bottom" Margin="16,0,6,0"
                                  ToolTip="Farbeagle – malt auch gern eigene Abenteuer"/>
                <StackPanel>
                    <TextBlock Text="FANGAMES" Style="{DynamicResource Hub.Label}"/>
                    <TextBlock Text="Fangames &amp; Hacks" Style="{DynamicResource Hub.Title}" Margin="0,4,0,2"/>
                    <TextBlock Style="{DynamicResource Hub.Muted}" MaxWidth="620" HorizontalAlignment="Left"
                               Text="Spiele von Fans – z. B. mit dem RPG Maker gebaut – oder ROM-Hacks mit eigenem Emulator. Einmal hinzufügen, dann startest du sie hier mit einem Klick."/>
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="Tiles" Margin="0,22,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FangameView}">
                        <Button Style="{DynamicResource Hub.Tile}" Width="236" Height="132" Margin="0,0,14,14" Click="Tile_Click" ToolTip="{Binding Game.Path}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Starten" Click="Tile_Click" FontWeight="Bold"/>
                                    <MenuItem Header="Speicherort öffnen" Click="OpenLocation_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Aus MonHub entfernen …" Click="Remove_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <DockPanel>
                                <Image Source="{Binding Icon}" DockPanel.Dock="Top" Width="44" Height="44" HorizontalAlignment="Left"/>
                                <StackPanel VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Game.Name}" Style="{DynamicResource Hub.Heading}" FontSize="15"/>
                                    <TextBlock Text="{Binding Status}" Style="{DynamicResource Hub.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- add -->
            <WrapPanel Margin="0,4,0,0">
                <Button Style="{DynamicResource Hub.Key}" Click="Add_Click" Margin="0,0,10,8">
                    <TextBlock Text="+  Fangame hinzufügen"/>
                </Button>
                <Button Style="{DynamicResource Hub.Ghost}" Click="OpenFolder_Click" Margin="0,0,10,8" ToolTip="Hier kannst du Fangames ablegen – musst du aber nicht">
                    <TextBlock Text="Fangames-Ordner öffnen"/>
                </Button>
            </WrapPanel>

            <ContentControl x:Name="EmptyHint" Style="{DynamicResource Hub.Inset}" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Style="{DynamicResource Hub.Muted}"
                           Text="Noch keine Fangames. Tipp: Entpack das Spiel am besten in den Fangames-Ordner und wähl dann beim Hinzufügen die Start-Datei (meist „Game.exe“)."/>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
