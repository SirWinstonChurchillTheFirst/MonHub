<Window x:Class="PokeHub.AddFangameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fangame hinzufügen" Style="{StaticResource Hub.DialogWindow}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Hub.Dialog}"
        Icon="{StaticResource PokeballImage}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <StackPanel Margin="26,22,26,22">
        <TextBlock Text="FANGAMES" Style="{DynamicResource Hub.Label}"/>
        <TextBlock Text="Fangame hinzufügen" Style="{DynamicResource Hub.Title}" FontSize="22" Margin="0,4,0,0"/>
        <TextBlock Style="{DynamicResource Hub.Muted}" Margin="0,6,0,16"
                   Text="Wähle die Start-Datei des Spiels – meistens eine .exe (z. B. „Game.exe“). Du kannst auch eine ROM oder andere Datei nehmen, die öffnet sich dann mit dem passenden Programm."/>

        <TextBlock Text="DATEI" Style="{DynamicResource Hub.Label}" Margin="0,0,0,5"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{DynamicResource Hub.Key}" Margin="8,0,0,0" Click="Browse_Click">Durchsuchen …</Button>
            <TextBox x:Name="TxtPath" VerticalContentAlignment="Center" TextChanged="TxtPath_TextChanged"/>
        </DockPanel>

        <TextBlock Text="NAME IM MONHUB" Style="{DynamicResource Hub.Label}" Margin="0,14,0,5"/>
        <TextBox x:Name="TxtName" TextChanged="TxtName_TextChanged"/>

        <!-- how the tile will look -->
        <ContentControl Style="{DynamicResource Hub.Inset}" Margin="0,18,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ImgIcon" Width="44" Height="44"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPreviewName" Style="{DynamicResource Hub.Heading}" Text="Vorschau"/>
                    <TextBlock Text="Fangame" Style="{DynamicResource Hub.Muted}"/>
                </StackPanel>
            </StackPanel>
        </ContentControl>

        <TextBlock x:Name="TxtError" Style="{DynamicResource Hub.Body}" Foreground="{DynamicResource Hub.Danger}" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{DynamicResource Hub.Ghost}" IsCancel="True" Margin="0,0,10,0" VerticalAlignment="Center">Abbrechen</Button>
            <Button x:Name="BtnOk" Style="{DynamicResource Hub.PrimaryKey}" IsDefault="True" Click="Ok_Click">Hinzufügen</Button>
        </StackPanel>
    </StackPanel>
</Window>
