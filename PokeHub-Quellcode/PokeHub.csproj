<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MonHub</AssemblyName>
    <!-- names Windows shows (Task Manager, "Open with" …) -->
    <AssemblyTitle>MonHub</AssemblyTitle>
    <Product>MonHub</Product>
    <Version>2.6.0</Version>
    <RootNamespace>PokeHub</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <ApplicationIcon>pokeball.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- animated trainer-card / rail sprites (PMD Sprite Collab, built by tools/build_sprites.py) -->
    <Resource Include="Assets\Sprites\*.png" />
    <!-- tools: generators and labs, not part of the app -->
    <Compile Remove="tools\**" />
  </ItemGroup>



  <ItemGroup>
    <!-- SafeFile, sprites and the randomizer classes (Rando\, Shared\) keep their RandoApp namespace -->
    <Using Include="RandoApp" />
  </ItemGroup>

  <ItemGroup>
    <!-- every Pokémon up to Gen 7 and the menu icons (PMD Sprite Collab, CC BY-NC 4.0), pixel fonts (SIL OFL); all built by tools/*.py -->
    <Resource Include="Assets\Species\*.png" />
    <Resource Include="Assets\Icons\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Nuzlocke\routes.json" />
    <!-- the tour guide's faces (PMD Sprite Collab, tools/build_assets.py) -->
    <Resource Include="Assets\Portraits\*.png" />
    <None Remove="tools\**" />
  </ItemGroup>

  <!-- "Neuer Run" (Rando\*): the randomizer helper (java\RandoHelper.java, built by installer\build-pokehub.ps1) -->
  <ItemGroup>
    <None Include="java\RandoHelper.jar" Link="RandoHelper.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
