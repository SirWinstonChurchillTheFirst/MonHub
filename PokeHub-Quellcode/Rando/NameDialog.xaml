<Window x:Class="RandoApp.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name für den Run" Style="{StaticResource Hub.DialogWindow}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Hub.Dialog}" Icon="{StaticResource PokeballImage}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Wie soll der neue Run heißen?" Style="{DynamicResource Hub.Heading}" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtName" TextChanged="TxtName_TextChanged" KeyDown="TxtName_KeyDown"/>
        <TextBlock x:Name="TxtError" Foreground="{DynamicResource Hub.Danger}" Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Automatischen Namen behalten" Click="BtnCancel_Click" Style="{DynamicResource Hub.Ghost}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="BtnOk" Content="Übernehmen" Click="BtnOk_Click" Style="{DynamicResource Hub.PrimaryKey}"/>
        </StackPanel>
    </StackPanel>
</Window>
