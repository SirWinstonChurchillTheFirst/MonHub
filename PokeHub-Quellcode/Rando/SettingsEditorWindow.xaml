<Window x:Class="RandoApp.SettingsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Randomizer-Settings bearbeiten" Style="{StaticResource Hub.DialogWindow}" Width="760" Height="820" MinHeight="500" MinWidth="600"
        Background="{DynamicResource Hub.Dialog}" Icon="{StaticResource PokeballImage}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,16,20,8">
            <StackPanel>
                <TextBlock Text="EINSTELLUNGEN" Style="{DynamicResource Hub.Label}"/>
                <TextBlock x:Name="TxtFile" Style="{DynamicResource Hub.Title}" FontSize="22" Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtMadeWith" Style="{DynamicResource Hub.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource Hub.Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtChanges" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{DynamicResource Hub.Muted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" IsCancel="True" Style="{DynamicResource Hub.Ghost}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSaveAs" Content="Als neue Datei speichern…" Click="BtnSaveAs_Click" Style="{DynamicResource Hub.Key}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnOverwrite" Content="Überschreiben" Click="BtnOverwrite_Click" Style="{DynamicResource Hub.PrimaryKey}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Groups" Margin="20,4,20,20"/>
        </ScrollViewer>
    </DockPanel>
</Window>
