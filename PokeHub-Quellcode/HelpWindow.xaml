<Window x:Class="PokeHub.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PokeHub"
        Title="So geht's" Style="{StaticResource Hub.DialogWindow}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Hub.Dialog}"
        Icon="{StaticResource PokeballImage}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- step number: a small ball-like badge -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource Hub.Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentEdge}"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,16,0"/>
        </Style>
        <Style x:Key="StepDigit" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Hub.FontDisplay}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Hub.AccentInk}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <DockPanel Margin="0,0,0,20">
                <local:SpriteView Key="0025/idle" DockPanel.Dock="Right" Height="56" VerticalAlignment="Bottom"/>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="SO GEHT'S" Style="{DynamicResource Hub.Label}"/>
                    <TextBlock Text="In 4 Schritten zum ersten Run" Style="{DynamicResource Hub.Title}" FontSize="24" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <ContentControl Style="{DynamicResource Hub.Panel}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepDigit}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Spiele holen" Style="{DynamicResource Hub.Heading}"/>
                            <TextBlock Style="{DynamicResource Hub.Muted}" Margin="0,3,0,0"
                                       Text="Unter „Spiele“ → „Ordner &amp; Import“ den ROM-Ordner öffnen und deine Pokémon-Spiele (.nds, .gba, .gb …) hineinkopieren – oder sie samt Spielständen von deinem bisherigen Emulator importieren. ROMs sind nicht dabei, die musst du selbst haben."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepDigit}"/></Border>
                        <StackPanel>
                            <TextBlock Text="„Neuer Run“ im Menü" Style="{DynamicResource Hub.Heading}"/>
                            <TextBlock Style="{DynamicResource Hub.Muted}" Margin="0,3,0,0"
                                       Text="Dort dein Original auswählen – Ordner, Emulator und Einstellungen sind schon fertig eingerichtet."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepDigit}"/></Border>
                        <StackPanel>
                            <TextBlock Text="„Mischen &amp; spielen“ drücken" Style="{DynamicResource Hub.Heading}"/>
                            <TextBlock Style="{DynamicResource Hub.Muted}" Margin="0,3,0,0"
                                       Text="Das Spiel wird neu gemischt und startet sofort. Später geht es hier unter „Weiter“ weiter – mit dem Spiel, das du zuletzt gespeichert hast, im richtigen Emulator."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" Style="{StaticResource StepDigit}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Sonderbonbons abholen (optional)" Style="{DynamicResource Hub.Heading}"/>
                            <TextBlock Style="{DynamicResource Hub.Muted}" Margin="0,3,0,0"
                                       Text="Mit dem Rare-Candy-Cheat: im Spiel L + R drücken (Diamant, Perl, Platin, HeartGold, SoulSilver) bzw. Select (Schwarz/Weiß 1+2) – dann liegen 999 Sonderbonbons in der Medizin-Tasche."/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{DynamicResource Hub.Inset}" Margin="0,16,0,0">
                <TextBlock Style="{DynamicResource Hub.Body}">
                    <Run Text="Speichern" FontWeight="Bold"/><Run Text=" macht das Spiel selbst – also im Spiel speichern! Die Spielstände liegen im Ordner „Spielstände“."/>
                    <LineBreak/>
                    <Run Text="Tasten" FontWeight="Bold"/><Run Text=" für melonDS stehen unter „Emulatoren“."/>
                    <LineBreak/>
                    <Run Text="Aufräumen" FontWeight="Bold"/><Run Text=" unter „Spiele“: „Spiel löschen“ nimmt ROM, Spielstände, Cheats und Spoiler mit, alles landet im Papierkorb. Spielstände ohne Spiel räumst du dort mit dem Gengar-Knopf auf."/>
                </TextBlock>
            </ContentControl>

            <Button Style="{DynamicResource Hub.PrimaryKey}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0,18,0,0">Los geht's!</Button>
        </StackPanel>
    </ScrollViewer>
</Window>
