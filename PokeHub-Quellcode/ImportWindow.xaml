<Window x:Class="PokeHub.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PokeHub"
        Title="Importieren" Style="{StaticResource Hub.DialogWindow}" Width="900" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Hub.Dialog}"
        Icon="{StaticResource PokeballImage}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <DockPanel Margin="26,20,26,20">
        <!-- header -->
        <DockPanel DockPanel.Dock="Top">
            <local:SpriteView Key="icon/import" DockPanel.Dock="Left" Width="32" Height="32" VerticalAlignment="Top" Margin="0,4,12,0"/>
            <StackPanel>
                <TextBlock Text="IMPORT" Style="{DynamicResource Hub.Label}"/>
                <TextBlock Text="Vom alten Emulator holen" Style="{DynamicResource Hub.Title}" Margin="0,4,0,2"/>
                <TextBlock Style="{DynamicResource Hub.Muted}"
                           Text="Übernimm ROMs und Spielstände von deinem bisherigen Emulator. Es wird nur kopiert – deine Originaldateien bleiben unverändert, und im MonHub wird nichts überschrieben."/>
            </StackPanel>
        </DockPanel>

        <!-- bottom: result + buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{DynamicResource Hub.Ghost}" IsCancel="True" Margin="0,0,10,0" VerticalAlignment="Center" Click="Close_Click">Schließen</Button>
                <Button x:Name="BtnImport" Style="{DynamicResource Hub.PrimaryKey}" Click="Import_Click">
                    <TextBlock x:Name="TxtImportButton" Text="Importieren"/>
                </Button>
            </StackPanel>
            <!-- while copying the die wobbles, when done it settles -->
            <local:SpriteView x:Name="Ball" Key="icon/dice" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,10,0"
                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.8" Visibility="Collapsed">
                <local:SpriteView.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="BallWobble"/>
                        <ScaleTransform x:Name="BallClick"/>
                    </TransformGroup>
                </local:SpriteView.RenderTransform>
            </local:SpriteView>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="TxtResult" Style="{DynamicResource Hub.Body}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ImportProgress" Height="6" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- sources -->
            <DockPanel Margin="0,18,0,6">
                <Button DockPanel.Dock="Right" Style="{DynamicResource Hub.Key}" Click="AddFolder_Click">Ordner hinzufügen …</Button>
                <TextBlock Text="WOHER?" Style="{DynamicResource Hub.Label}" VerticalAlignment="Center"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Style="{DynamicResource Hub.Inset}" MinHeight="54">
                <Grid>
                    <StackPanel x:Name="SearchingPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"/>
                        <TextBlock Text="Suche nach Emulatoren auf diesem PC …" Style="{DynamicResource Hub.Muted}" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtNoSources" Visibility="Collapsed" VerticalAlignment="Center" Style="{DynamicResource Hub.Muted}"
                               Text="Kein Emulator automatisch gefunden. Wähle mit „Ordner hinzufügen …“ den Ordner deines Emulators oder deiner ROMs."/>
                    <ItemsControl x:Name="SourceList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Checked="Source_Toggled" Unchecked="Source_Toggled" Margin="0,3" Foreground="{DynamicResource Hub.Ink}">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Hub.Ink}">
                                        <Run Text="{Binding Source.Label, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text="{Binding Source.Folder, Mode=OneWay}" Foreground="{DynamicResource Hub.InkMuted}"/>
                                        <Run Text="{Binding ExtraText, Mode=OneWay}" Foreground="{DynamicResource Hub.InkMuted}" FontStyle="Italic"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ContentControl>

            <!-- found files -->
            <DockPanel Grid.Row="2" Margin="0,18,0,6">
                <TextBlock x:Name="TxtSummary" DockPanel.Dock="Right" Style="{DynamicResource Hub.Muted}" VerticalAlignment="Center"/>
                <TextBlock Text="GEFUNDEN" Style="{DynamicResource Hub.Label}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Grid.Row="3" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource Hub.RadiusInner}" Padding="2">
                <ListView x:Name="ItemList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Hub.Ink}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{DynamicResource Hub.ColumnHeader}">
                            <GridViewColumn Width="44">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected}" Checked="Item_Toggled" Unchecked="Item_Toggled"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Art" Width="160" DisplayMemberBinding="{Binding KindText}"/>
                            <GridViewColumn Header="Datei" Width="330" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Größe" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                            <GridViewColumn Header="Status" Width="180" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </DockPanel>
</Window>
