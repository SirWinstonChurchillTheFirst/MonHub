<Window x:Class="PokeHub.OrphanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PokeHub"
        Title="Spielstände ohne Spiel" Style="{StaticResource Hub.DialogWindow}" Width="860" Height="700" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Hub.Dialog}"
        Icon="{StaticResource PokeballImage}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- one game name whose ROM is gone: where its saves are, when it was last saved, how big -->
        <DataTemplate x:Key="OrphanTemplate" DataType="{x:Type local:OrphanSave}">
            <Grid Height="68" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Im Ordner zeigen" Click="ShowFile_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Center"
                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"/>
                <!-- where it lives: a coloured edge like a save file's label -->
                <Border x:Name="Place" Grid.Column="1" Width="5" Margin="0,12" CornerRadius="2" Background="#7C8BA6" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{DynamicResource Hub.Body}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,5,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Hub.SurfaceAlt}" BorderBrush="{DynamicResource Hub.InsetLine}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Hub.RadiusChip}" Padding="7,1" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource Hub.FontLabel}" FontSize="{DynamicResource Hub.SizeTag}" Foreground="{DynamicResource Hub.InkMuted}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="{Binding TimeText}" Style="{DynamicResource Hub.Body}" HorizontalAlignment="Right" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding SizeText}" Style="{DynamicResource Hub.Muted}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MainPlace}" Value="melonDS">
                    <Setter TargetName="Place" Property="Background" Value="#2F8CE0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MainPlace}" Value="DeSmuME">
                    <Setter TargetName="Place" Property="Background" Value="#7B5BD6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MainPlace}" Value="GBA/GB">
                    <Setter TargetName="Place" Property="Background" Value="#3FAE5B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MainPlace}" Value="ROM-Ordner">
                    <Setter TargetName="Place" Property="Background" Value="#E0922B"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="26,20,26,18">
        <!-- header -->
        <DockPanel DockPanel.Dock="Top">
            <local:SpriteView Key="0094/idle" Height="56" VerticalAlignment="Top" Margin="0,0,16,0"/>
            <StackPanel>
                <TextBlock Text="AUFRÄUMEN" Style="{DynamicResource Hub.Label}"/>
                <TextBlock Text="Spielstände ohne Spiel" Style="{DynamicResource Hub.Title}" Margin="0,4,0,2"/>
                <TextBlock Style="{DynamicResource Hub.Muted}"
                           Text="Zu diesen Spielständen gibt es kein Spiel mehr im MonHub – meist wurde die ROM gelöscht oder umbenannt. Was du löschst, kommt in den Papierkorb."/>
            </StackPanel>
        </DockPanel>

        <!-- select all + totals -->
        <DockPanel DockPanel.Dock="Top" Margin="22,18,6,10">
            <TextBlock x:Name="TxtCount" DockPanel.Dock="Right" Style="{DynamicResource Hub.Muted}" VerticalAlignment="Center"/>
            <CheckBox x:Name="ChkAll" Content="Alle auswählen" Checked="All_Toggled" Unchecked="All_Toggled" Foreground="{DynamicResource Hub.Ink}"/>
        </DockPanel>

        <!-- bottom buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="BtnDelete" DockPanel.Dock="Right" Style="{DynamicResource Hub.DangerKey}" MinWidth="150" Click="Delete_Click" IsEnabled="False">
                <TextBlock x:Name="TxtDelete" Text="Löschen"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{DynamicResource Hub.Ghost}" IsCancel="True" Margin="0,0,12,0" VerticalAlignment="Center">Schließen</Button>
        </DockPanel>

        <!-- the saves -->
        <Grid>
            <ListBox x:Name="SaveList" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Multiple"
                     ItemTemplate="{StaticResource OrphanTemplate}" ItemContainerStyle="{DynamicResource Hub.Card}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="SaveList_SelectionChanged"/>
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:SpriteView Key="0025/idle" Height="84" HorizontalAlignment="Center"/>
                <TextBlock Text="Alles aufgeräumt!" Style="{DynamicResource Hub.Heading}" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="Es gibt keine Spielstände ohne Spiel." Style="{DynamicResource Hub.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
