# Only MonHub's own sources go into the repository – this folder also holds the player's ROMs, presets, builds and the
# randomizer download, which stay local.
/*
!/.gitignore
!/.github/
!/docs/
!/LICENSE
!/README.md
!/MonHub/
!/MonHub.Tests/

# build output
bin/
obj/
.vs/
*.user

# Pictures are NOT in the repository: MonHub/tools/*.py download them from PMD Sprite Collab (CC BY-NC 4.0,
# credits in CREDITS.md) on the first build. The fonts (SIL OFL) are downloaded the same way.
/MonHub/Assets/Species/
/MonHub/Assets/Sprites/
/MonHub/Assets/Items/
/MonHub/Assets/Portraits/
/MonHub/Assets/Fonts/*.ttf
/MonHub/monhub.ico
/MonHub/installer/art/*.bmp
/MonHub/installer/art/*.png
/MonHub/java/RandoHelper.jar
/MonHub/java/build/
/MonHub/tools/.cache/
