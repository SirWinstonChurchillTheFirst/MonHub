<Application x:Class="MonHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Design system; the theme dictionary (Themes\<id>.xaml) is added after it at startup by HubThemes.Apply -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- window icon: Porygon's face (PMD Sprite Collab) -->
            <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/Assets/Portraits/0137-Normal.png"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
