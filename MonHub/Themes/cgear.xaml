<!--
    C-Gear: night blue like the touch screen in Black/White. Rings of light in the corner, a small ring in the emblem
    that turns, surfaces with cut corners (big radius on two corners, almost none on the others), a cyan bar marks the
    current page. DIN-like type (Bahnschrift, part of Windows).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:MonHub">

    <SolidColorBrush x:Key="Hub.Bg" Color="#070B1F"/>
    <SolidColorBrush x:Key="Hub.Rail" Color="#0A1130"/>
    <SolidColorBrush x:Key="Hub.RailLine" Color="#1C2B66"/>
    <SolidColorBrush x:Key="Hub.RailInk" Color="#C9D6F5"/>
    <SolidColorBrush x:Key="Hub.RailInkMuted" Color="#6F82B8"/>
    <SolidColorBrush x:Key="Hub.RailHover" Color="#121C45"/>
    <SolidColorBrush x:Key="Hub.RailSelected" Color="#15245C"/>
    <SolidColorBrush x:Key="Hub.RailSelectedInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.RailCursor" Color="#35D2FF"/>

    <SolidColorBrush x:Key="Hub.Surface" Color="#0E1839"/>
    <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#0A1330"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#121F4A"/>
    <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#132656"/>
    <SolidColorBrush x:Key="Hub.Ink" Color="#D6E2FF"/>
    <SolidColorBrush x:Key="Hub.InkStrong" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.InkMuted" Color="#7C8FC2"/>
    <SolidColorBrush x:Key="Hub.Line" Color="#1D2D68"/>
    <SolidColorBrush x:Key="Hub.LineStrong" Color="#2C4088"/>
    <SolidColorBrush x:Key="Hub.InsetLine" Color="#1A2A60"/>
    <SolidColorBrush x:Key="Hub.Selection" Color="#35D2FF"/>

    <SolidColorBrush x:Key="Hub.Accent" Color="#35D2FF"/>
    <SolidColorBrush x:Key="Hub.AccentEdge" Color="#1488B3"/>
    <SolidColorBrush x:Key="Hub.AccentInk" Color="#04142A"/>
    <SolidColorBrush x:Key="Hub.KeyFace" Color="#15224F"/>
    <SolidColorBrush x:Key="Hub.KeyEdge" Color="#050A1E"/>
    <SolidColorBrush x:Key="Hub.KeyInk" Color="#D6E2FF"/>
    <SolidColorBrush x:Key="Hub.KeyLine" Color="#27397A"/>
    <SolidColorBrush x:Key="Hub.HoverOverlay" Color="#1435D2FF"/>
    <SolidColorBrush x:Key="Hub.PressOverlay" Color="#26000000"/>
    <SolidColorBrush x:Key="Hub.Good" Color="#4BE3A0"/>
    <SolidColorBrush x:Key="Hub.Danger" Color="#FF6B7D"/>
    <SolidColorBrush x:Key="Hub.DangerSoft" Color="#26FF6B7D"/>
    <SolidColorBrush x:Key="Hub.DangerFace" Color="#E0485C"/>
    <SolidColorBrush x:Key="Hub.DangerEdge" Color="#8E2335"/>
    <SolidColorBrush x:Key="Hub.DangerInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.Dialog" Color="#070B1F"/>
    <SolidColorBrush x:Key="Hub.SlotFill" Color="#0A1330"/>
    <SolidColorBrush x:Key="Hub.SlotLine" Color="#1D2D68"/>
    <SolidColorBrush x:Key="Hub.BadgeOn" Color="#FFD84A"/>
    <SolidColorBrush x:Key="Hub.BadgeOff" Color="#1D2D68"/>
    <SolidColorBrush x:Key="Hub.ChipOn" Color="#35D2FF"/>
    <SolidColorBrush x:Key="Hub.ChipOnInk" Color="#04142A"/>

    <CornerRadius x:Key="Hub.RadiusPanel">18,3,18,3</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusInner">12,2,12,2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusControl">12,2,12,2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusChip">10,2,10,2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCard">14,2,14,2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCheck">6,1,6,1</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusSlot">10,2,10,2</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusNav">12,2,12,2</CornerRadius>
    <Visibility x:Key="Hub.ShadowVisibility">Collapsed</Visibility>
    <Thickness x:Key="Hub.KeyDepth">0,0,0,2</Thickness>
    <Thickness x:Key="Hub.NavMargin">10,2</Thickness>

    <FontFamily x:Key="Hub.FontDisplay">Bahnschrift SemiBold, Segoe UI Variable Display, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontLabel">Bahnschrift, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontNav">Bahnschrift, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontValue">Bahnschrift, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontWeight x:Key="Hub.WeightTitle">Normal</FontWeight>
    <FontWeight x:Key="Hub.WeightLabel">Normal</FontWeight>
    <sys:Double x:Key="Hub.SizeTitle">28</sys:Double>
    <sys:Double x:Key="Hub.SizeLabel">11.5</sys:Double>
    <sys:Double x:Key="Hub.SizeNav">15</sys:Double>
    <sys:Double x:Key="Hub.SizeValue">16</sys:Double>

    <!-- rings of light in the lower right corner. They stand still on purpose: turning, they sat behind the page and made
         a PC without graphics card redraw that whole area with all its text every frame (34 % of a core in the test VM
         instead of about 8 %). The small ring in the emblem turns instead. -->
    <DataTemplate x:Key="Hub.Backdrop">
        <Grid ClipToBounds="True">
            <Grid Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-290">
                <Ellipse Stroke="#35D2FF" StrokeThickness="2" Opacity="0.16"/>
                <Ellipse Margin="46" Stroke="#35D2FF" StrokeThickness="10" StrokeDashArray="0.4 1.6" Opacity="0.10"/>
                <Ellipse Margin="112" Stroke="#35D2FF" StrokeThickness="2" StrokeDashArray="18 10" Opacity="0.22"/>
                <Ellipse Margin="176" Stroke="#6E8CFF" StrokeThickness="1.5" Opacity="0.20"/>
            </Grid>
            <Ellipse Width="220" Height="220" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-110,0,0"
                     Stroke="#35D2FF" StrokeThickness="1.5" Opacity="0.10"/>
        </Grid>
    </DataTemplate>

    <!-- emblem: a ring that turns, the name -->
    <DataTemplate x:Key="Hub.RailIdentity">
        <StackPanel Margin="20,22,16,18">
            <StackPanel Orientation="Horizontal">
                <Grid Width="44" Height="44">
                    <Ellipse Stroke="#35D2FF" StrokeThickness="2"/>
                    <Ellipse Margin="7" Stroke="#35D2FF" StrokeThickness="2.5" StrokeDashArray="2.5 1.5" Opacity="0.75" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform/>
                        </Ellipse.RenderTransform>
                        <local:Ambient.Storyboard>
                            <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="15">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:14"/>
                            </Storyboard>
                        </local:Ambient.Storyboard>
                    </Ellipse>
                    <Ellipse Margin="16" Fill="#35D2FF"/>
                </Grid>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MonHub" FontFamily="{DynamicResource Hub.FontDisplay}" FontSize="22" Foreground="#FFFFFF"/>
                    <TextBlock Text="NEON" FontFamily="{DynamicResource Hub.FontLabel}" FontSize="11" Foreground="#35D2FF"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- at the foot of the menu: the C-Gear's three round buttons; the wireless one glows now and then -->
    <DataTemplate x:Key="CGear.Button">
        <Grid Width="46" Height="46" Margin="4,0">
            <Ellipse Stroke="#35D2FF" StrokeThickness="2" Fill="#0E1839"/>
            <Ellipse Margin="5" Stroke="#1C2B66" StrokeThickness="1"/>
            <TextBlock Text="{Binding}" FontFamily="Bahnschrift" FontSize="10.5" Foreground="#9FE6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Hub.RailDeco">
        <StackPanel Margin="0,0,0,14" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ContentControl Content="IR" ContentTemplate="{DynamicResource CGear.Button}" Focusable="False"/>
                <Grid>
                    <ContentControl Content="WLAN" ContentTemplate="{DynamicResource CGear.Button}" Focusable="False"/>
                    <Ellipse Width="46" Height="46" Fill="#35D2FF" Opacity="0">
                        <local:Ambient.Storyboard>
                            <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="10">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:6">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0.28"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </local:Ambient.Storyboard>
                    </Ellipse>
                </Grid>
                <ContentControl Content="WEB" ContentTemplate="{DynamicResource CGear.Button}" Focusable="False"/>
            </StackPanel>
            <TextBlock Text="NEON ONLINE" FontFamily="Bahnschrift" FontSize="10" Foreground="#6F82B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
