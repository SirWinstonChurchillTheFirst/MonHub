<!--
    MonHub design system. Every style here is built from tokens (Hub.*) that each theme sets in Themes\<id>.xaml;
    a theme can also replace a whole style where its identity needs a different shape (e.g. Game Boy text boxes).
    All references to tokens and styles are DynamicResource, so switching themes just swaps one dictionary.

    Performance rules: no BlurEffect / DropShadowEffect (soft shadows force re-rendering the whole area whenever an animated
    sprite inside changes) – shadows are hard, offset shapes. Patterns are DrawingBrushes with caching.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:MonHub">

    <!-- ================= Fonts (embedded, SIL Open Font License) ================= -->
    <FontFamily x:Key="Font.Silkscreen">pack://application:,,,/Assets/Fonts/#Silkscreen, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Font.Pixelify">pack://application:,,,/Assets/Fonts/#Pixelify Sans, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Font.PressStart">pack://application:,,,/Assets/Fonts/#Press Start 2P, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Font.UIDisplay">Segoe UI Variable Display, Segoe UI, Segoe UI Symbol</FontFamily>

    <!-- ================= Token defaults (a calm light look; every theme overrides them) ================= -->
    <SolidColorBrush x:Key="Hub.Bg" Color="#F4F4F2"/>
    <SolidColorBrush x:Key="Hub.Rail" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.RailLine" Color="#E3E3E0"/>
    <SolidColorBrush x:Key="Hub.RailInk" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Hub.RailInkMuted" Color="#8A8A86"/>
    <SolidColorBrush x:Key="Hub.RailHover" Color="#F1F1EE"/>
    <SolidColorBrush x:Key="Hub.RailSelected" Color="#FBE9E6"/>
    <SolidColorBrush x:Key="Hub.RailSelectedInk" Color="#B42B1C"/>
    <SolidColorBrush x:Key="Hub.RailCursor" Color="#B42B1C"/>
    <SolidColorBrush x:Key="Hub.RailInnerLine" Color="Transparent"/>

    <!-- the menu: which side (0 = left, 2 = right), width, frame; retro themes write menu entries in capitals -->
    <sys:Int32 x:Key="Hub.RailColumn">0</sys:Int32>
    <sys:Double x:Key="Hub.RailWidth">224</sys:Double>
    <Thickness x:Key="Hub.RailBorder">0,0,1,0</Thickness>
    <Thickness x:Key="Hub.RailMargin">0</Thickness>
    <!-- the menu runs up under MonHub's title bar (34 px); its content starts a little lower -->
    <Thickness x:Key="Hub.RailTitleInset">0,12,0,0</Thickness>
    <CornerRadius x:Key="Hub.RailRadius">0</CornerRadius>
    <Thickness x:Key="Hub.RailInnerBorder">0</Thickness>
    <Thickness x:Key="Hub.RailInnerGap">0</Thickness>
    <Visibility x:Key="Hub.NavIconVisibility">Visible</Visibility>
    <sys:Boolean x:Key="Hub.NavCaps">False</sys:Boolean>

    <SolidColorBrush x:Key="Hub.ScreenBezel" Color="Transparent"/>
    <SolidColorBrush x:Key="Hub.Screen" Color="Transparent"/>
    <SolidColorBrush x:Key="Hub.ScreenOverlay" Color="Transparent"/>
    <Thickness x:Key="Hub.ScreenBezelThickness">0</Thickness>
    <Thickness x:Key="Hub.ScreenMargin">0</Thickness>
    <CornerRadius x:Key="Hub.ScreenRadius">0</CornerRadius>
    <CornerRadius x:Key="Hub.ScreenInnerRadius">0</CornerRadius>

    <SolidColorBrush x:Key="Hub.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.SurfaceAlt" Color="#F7F7F5"/>
    <SolidColorBrush x:Key="Hub.SurfaceHover" Color="#FAFAF8"/>
    <SolidColorBrush x:Key="Hub.SurfaceSelected" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.Ink" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Hub.InkStrong" Color="#141414"/>
    <SolidColorBrush x:Key="Hub.InkMuted" Color="#7B7B77"/>
    <SolidColorBrush x:Key="Hub.Line" Color="#E3E3E0"/>
    <SolidColorBrush x:Key="Hub.LineStrong" Color="#CFCFCB"/>
    <SolidColorBrush x:Key="Hub.InnerLine" Color="Transparent"/>
    <SolidColorBrush x:Key="Hub.InsetLine" Color="#ECECE8"/>
    <SolidColorBrush x:Key="Hub.Selection" Color="#D93A26"/>

    <SolidColorBrush x:Key="Hub.Accent" Color="#D93A26"/>
    <SolidColorBrush x:Key="Hub.AccentEdge" Color="#A82816"/>
    <SolidColorBrush x:Key="Hub.AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.KeyFace" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Hub.KeyEdge" Color="#D6D6D2"/>
    <SolidColorBrush x:Key="Hub.KeyInk" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Hub.KeyLine" Color="#D6D6D2"/>
    <SolidColorBrush x:Key="Hub.HoverOverlay" Color="#0A000000"/>
    <SolidColorBrush x:Key="Hub.PressOverlay" Color="#14000000"/>
    <SolidColorBrush x:Key="Hub.Good" Color="#2E9E57"/>
    <SolidColorBrush x:Key="Hub.Danger" Color="#C8321E"/>
    <SolidColorBrush x:Key="Hub.DangerSoft" Color="#1FC8321E"/>
    <SolidColorBrush x:Key="Hub.DangerFace" Color="#C8321E"/>
    <SolidColorBrush x:Key="Hub.DangerEdge" Color="#962414"/>
    <SolidColorBrush x:Key="Hub.DangerInk" Color="#FFFFFF"/>
    <!-- background of dialogs (import, help, saves without a game) -->
    <SolidColorBrush x:Key="Hub.Dialog" Color="#F4F4F2"/>
    <SolidColorBrush x:Key="Hub.Shadow" Color="#14000000"/>
    <SolidColorBrush x:Key="Hub.SlotFill" Color="#F7F7F5"/>
    <SolidColorBrush x:Key="Hub.SlotLine" Color="#E3E3E0"/>
    <SolidColorBrush x:Key="Hub.BadgeOn" Color="#D9A21B"/>
    <SolidColorBrush x:Key="Hub.BadgeOff" Color="#E3E3E0"/>
    <SolidColorBrush x:Key="Hub.ChipOn" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Hub.ChipOnInk" Color="#FFFFFF"/>

    <CornerRadius x:Key="Hub.RadiusPanel">10</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusInner">6</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusChip">14</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusSlot">6</CornerRadius>
    <CornerRadius x:Key="Hub.RadiusNav">8</CornerRadius>
    <Thickness x:Key="Hub.PanelBorder">1</Thickness>
    <Thickness x:Key="Hub.InnerBorder">0</Thickness>
    <Thickness x:Key="Hub.InnerGap">0</Thickness>
    <Thickness x:Key="Hub.PanelPadding">18,16</Thickness>
    <Thickness x:Key="Hub.CardBorder">1</Thickness>
    <Thickness x:Key="Hub.CardMargin">0,0,4,6</Thickness>
    <Thickness x:Key="Hub.SelectionBorder">2</Thickness>
    <Thickness x:Key="Hub.ShadowOffset">0,2,0,-2</Thickness>
    <Visibility x:Key="Hub.ShadowVisibility">Visible</Visibility>
    <Thickness x:Key="Hub.KeyDepth">0,0,0,2</Thickness>
    <Thickness x:Key="Hub.KeyBorder">1</Thickness>
    <Thickness x:Key="Hub.NavMargin">8,1</Thickness>
    <Visibility x:Key="Hub.CursorVisibility">Hidden</Visibility>
    <Visibility x:Key="Hub.CursorHoverVisibility">Hidden</Visibility>
    <Visibility x:Key="Hub.IndicatorVisibility">Visible</Visibility>
    <!-- ▶ in front of the selected game (Game Boy) -->
    <Visibility x:Key="Hub.CardCursorVisibility">Collapsed</Visibility>
    <sys:String x:Key="Hub.CursorText">▶</sys:String>

    <!-- written out, not as <StaticResource> aliases: WPF mixes up such aliases in merged dictionaries -->
    <FontFamily x:Key="Hub.FontDisplay">Segoe UI Variable Display, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontLabel">Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontBody">Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontNav">Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="Hub.FontValue">Segoe UI Variable Display, Segoe UI, Segoe UI Symbol</FontFamily>
    <sys:Double x:Key="Hub.SizeTitle">26</sys:Double>
    <sys:Double x:Key="Hub.SizeHeading">17</sys:Double>
    <sys:Double x:Key="Hub.SizeLabel">11</sys:Double>
    <sys:Double x:Key="Hub.SizeNav">14</sys:Double>
    <sys:Double x:Key="Hub.SizeValue">15</sys:Double>
    <!-- small tags on colour (version, "STANDARD") -->
    <sys:Double x:Key="Hub.SizeTag">10</sys:Double>
    <FontWeight x:Key="Hub.WeightTitle">SemiBold</FontWeight>
    <FontWeight x:Key="Hub.WeightLabel">SemiBold</FontWeight>
    <FontWeight x:Key="Hub.WeightNav">Normal</FontWeight>

    <!-- playful themes lay the trainer card slightly crooked on the table -->
    <sys:Double x:Key="Hub.CardTilt">0</sys:Double>

    <!-- decoration behind everything, the identity block at the top of the menu and a detail at its bottom
         (hidden when the window is too low): themes provide their own -->
    <DataTemplate x:Key="Hub.Backdrop">
        <Grid/>
    </DataTemplate>
    <DataTemplate x:Key="Hub.RailIdentity">
        <StackPanel Margin="20,22,16,18">
            <TextBlock Text="MonHub" FontFamily="{DynamicResource Hub.FontDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Hub.RailInk}"/>
            <TextBlock Text="{local:L 'Dein Spielzentrum', 'Your game hub'}" Foreground="{DynamicResource Hub.RailInkMuted}" FontSize="12"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="Hub.RailDeco">
        <Grid/>
    </DataTemplate>

    <!-- ================= Text ================= -->
    <Style x:Key="Hub.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeTitle}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Hub.WeightTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkStrong}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Hub.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontDisplay}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeHeading}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Hub.WeightTitle}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkStrong}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Hub.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontLabel}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeLabel}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Hub.WeightLabel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkMuted}"/>
    </Style>
    <Style x:Key="Hub.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hub.Muted" TargetType="TextBlock" BasedOn="{StaticResource Hub.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkMuted}"/>
    </Style>
    <Style x:Key="Hub.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontValue}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeValue}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkStrong}"/>
    </Style>

    <!-- ================= Containers ================= -->
    <!-- Panel: hard offset shadow, frame, optional inner frame (double-line text boxes in retro themes) -->
    <Style x:Key="Hub.Panel" TargetType="ContentControl">
        <Setter Property="Padding" Value="{DynamicResource Hub.PanelPadding}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{DynamicResource Hub.Shadow}" CornerRadius="{DynamicResource Hub.RadiusPanel}"
                                Margin="{DynamicResource Hub.ShadowOffset}" Visibility="{DynamicResource Hub.ShadowVisibility}"/>
                        <Border Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Line}"
                                BorderThickness="{DynamicResource Hub.PanelBorder}" CornerRadius="{DynamicResource Hub.RadiusPanel}">
                            <Border BorderBrush="{DynamicResource Hub.InnerLine}" BorderThickness="{DynamicResource Hub.InnerBorder}"
                                    Margin="{DynamicResource Hub.InnerGap}" CornerRadius="{DynamicResource Hub.RadiusInner}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset: a recessed area inside a panel (the "continue" box, info blocks) -->
    <Style x:Key="Hub.Inset" TargetType="ContentControl">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource Hub.SurfaceAlt}" BorderBrush="{DynamicResource Hub.InsetLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource Hub.RadiusInner}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The content area (Dex: dark display behind a bezel, with scanlines on top) -->
    <Style x:Key="Hub.ScreenFrame" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource Hub.ScreenBezel}" Padding="{DynamicResource Hub.ScreenBezelThickness}"
                            Margin="{DynamicResource Hub.ScreenMargin}" CornerRadius="{DynamicResource Hub.ScreenRadius}">
                        <Grid>
                            <Border Background="{DynamicResource Hub.Screen}" CornerRadius="{DynamicResource Hub.ScreenInnerRadius}"/>
                            <ContentPresenter/>
                            <Border Background="{DynamicResource Hub.ScreenOverlay}" CornerRadius="{DynamicResource Hub.ScreenInnerRadius}" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hub.Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Hub.Line}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ================= Buttons ================= -->
    <!-- A key: face on a darker edge; pressing pushes the face down onto the edge (no animation, no effect) -->
    <Style x:Key="Hub.Key" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Hub.KeyFace}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.KeyEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.KeyInk}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Edge" Background="{TemplateBinding BorderBrush}" CornerRadius="{DynamicResource Hub.RadiusControl}"/>
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Hub.RadiusControl}"
                                BorderBrush="{DynamicResource Hub.KeyLine}" BorderThickness="{DynamicResource Hub.KeyBorder}"
                                Margin="{DynamicResource Hub.KeyDepth}">
                            <Grid>
                                <Border x:Name="Tint" CornerRadius="{DynamicResource Hub.RadiusControl}"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Hub.HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,2,0,0"/>
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Hub.PressOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hub.PrimaryKey" TargetType="Button" BasedOn="{StaticResource Hub.Key}">
        <Setter Property="Background" Value="{DynamicResource Hub.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.AccentEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.AccentInk}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontDisplay}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="22,11"/>
    </Style>

    <!-- the one button that deletes something -->
    <Style x:Key="Hub.DangerKey" TargetType="Button" BasedOn="{StaticResource Hub.Key}">
        <Setter Property="Background" Value="{DynamicResource Hub.DangerFace}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.DangerEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.DangerInk}"/>
        <Setter Property="Padding" Value="18,9"/>
    </Style>

    <!-- quiet text action; Tag="Danger" turns red on hover -->
    <Style x:Key="Hub.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkMuted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Hub.RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.HoverOverlay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value="Danger"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.DangerSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.Danger}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Menu ================= -->
    <!-- Menu entry: ▶ cursor (retro themes) or an indicator bar (modern themes) marks the current page -->
    <Style x:Key="Hub.Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Hub.RailInk}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontNav}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeNav}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Hub.WeightNav}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Hub.RadiusNav}" Padding="10,7"
                            Margin="{DynamicResource Hub.NavMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="4" Height="20" CornerRadius="2" Background="{DynamicResource Hub.RailSelectedInk}"
                                    HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Hidden"/>
                            <TextBlock x:Name="Cursor" Text="{DynamicResource Hub.CursorText}" FontFamily="{StaticResource Font.Silkscreen}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Hub.RailCursor}" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.RailHover}"/>
                            <Setter TargetName="Cursor" Property="Visibility" Value="{DynamicResource Hub.CursorHoverVisibility}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.RailSelected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.RailSelectedInk}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="{DynamicResource Hub.IndicatorVisibility}"/>
                            <Setter TargetName="Cursor" Property="Visibility" Value="{DynamicResource Hub.CursorVisibility}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cursor" Property="Visibility" Value="{DynamicResource Hub.CursorVisibility}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A menu action that opens something else (der Randomizer) – same look as a menu entry, never "selected" -->
    <Style x:Key="Hub.NavAction" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hub.RailInk}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontNav}"/>
        <Setter Property="FontSize" Value="{DynamicResource Hub.SizeNav}"/>
        <Setter Property="FontWeight" Value="{DynamicResource Hub.WeightNav}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Hub.RadiusNav}" Padding="10,7"
                            Margin="{DynamicResource Hub.NavMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Cursor" Text="{DynamicResource Hub.CursorText}" FontFamily="{StaticResource Font.Silkscreen}" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Hub.RailCursor}" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.RailHover}"/>
                            <Setter TargetName="Cursor" Property="Visibility" Value="{DynamicResource Hub.CursorHoverVisibility}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.RailSelected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- small text link at the bottom of the menu -->
    <Style x:Key="Hub.RailLink" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hub.RailInkMuted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4,4">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Hub.RailInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Lists ================= -->
    <Style x:Key="Hub.Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="{DynamicResource Hub.RadiusChip}" Padding="12,5" Background="Transparent"
                            BorderBrush="{DynamicResource Hub.LineStrong}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.ChipOn}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Hub.ChipOn}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.ChipOnInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in a list (games, saves): the item draws its own selection -->
    <Style x:Key="Hub.Card" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="{DynamicResource Hub.CardMargin}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border Background="{DynamicResource Hub.Shadow}" CornerRadius="{DynamicResource Hub.RadiusCard}"
                                Margin="{DynamicResource Hub.ShadowOffset}" Visibility="{DynamicResource Hub.ShadowVisibility}"/>
                        <Border x:Name="Bd" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Line}"
                                BorderThickness="{DynamicResource Hub.CardBorder}" CornerRadius="{DynamicResource Hub.RadiusCard}">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="Sel" BorderBrush="{DynamicResource Hub.Selection}" BorderThickness="{DynamicResource Hub.SelectionBorder}"
                                CornerRadius="{DynamicResource Hub.RadiusCard}" Visibility="Hidden" IsHitTestVisible="False"/>
                        <TextBlock x:Name="Cursor" Text="{DynamicResource Hub.CursorText}" FontFamily="{StaticResource Font.Silkscreen}" FontSize="11"
                                   Foreground="{DynamicResource Hub.Selection}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-14,0,0,0"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.SurfaceSelected}"/>
                            <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Cursor" Property="Visibility" Value="{DynamicResource Hub.CardCursorVisibility}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A plain row (recent saves on the start page): no card, a line underneath -->
    <Style x:Key="Hub.Row" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Hub.Line}" BorderThickness="0,0,0,1" Padding="4,6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.HoverOverlay}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A party slot -->
    <Style x:Key="Hub.Slot" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hub.SlotFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.SlotLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Hub.RadiusSlot}"/>
    </Style>

    <!-- One party member: sprite (moves only while pointed at) and level, name in the tooltip -->
    <DataTemplate x:Key="Hub.TeamSlotTemplate" DataType="{x:Type local:TeamSlot}">
        <Border x:Name="Slot" Style="{DynamicResource Hub.Slot}" Width="54" Height="62" Margin="0,0,6,0" ToolTip="{Binding Tooltip}" Background="{DynamicResource Hub.SlotFill}">
            <Grid>
                <local:SpriteView x:Name="Sprite" Key="{Binding Sprite}" Still="True" Decorative="True" MaxWidth="46" MaxHeight="40"
                                  Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center" Margin="0,2,0,14"/>
                <TextBlock Text="{local:L 'Ei', 'Egg'}" Visibility="{Binding EggVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14"
                           Style="{DynamicResource Hub.Label}"/>
                <TextBlock Text="{Binding LevelText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                           FontFamily="{DynamicResource Hub.FontLabel}" FontSize="10" Foreground="{DynamicResource Hub.InkMuted}"/>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Slot" Property="IsMouseOver" Value="True">
                <Setter TargetName="Sprite" Property="Still" Value="False"/>
                <Setter TargetName="Slot" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A smaller party row (lists) -->
    <DataTemplate x:Key="Hub.TeamMiniTemplate" DataType="{x:Type local:TeamSlot}">
        <local:SpriteView Key="{Binding Sprite}" Still="True" Width="26" Height="24" Stretch="Uniform" StretchDirection="DownOnly"
                          Margin="0,0,2,0" ToolTip="{Binding Tooltip}"/>
    </DataTemplate>

    <!-- Badge case: one dot per badge, filled when earned -->
    <DataTemplate x:Key="Hub.BadgeTemplate">
        <Ellipse x:Name="Dot" Width="11" Height="11" Margin="0,0,4,0" Fill="{DynamicResource Hub.BadgeOff}"/>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hub.BadgeOn}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A keyboard key for the controls map -->
    <Style x:Key="Hub.KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hub.KeyFace}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.KeyEdge}"/>
        <Setter Property="BorderThickness" Value="1,1,1,3"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="MinWidth" Value="30"/>
    </Style>

    <!-- Search box without the default chrome -->
    <Style x:Key="Hub.Search" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="30,7,10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.LineStrong}"
                            BorderThickness="1" CornerRadius="{DynamicResource Hub.RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/> <!-- the TextBox applies its Padding itself -->
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A clickable tile (fangames, theme choice) -->
    <Style x:Key="Hub.Tile" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{DynamicResource Hub.Shadow}" CornerRadius="{DynamicResource Hub.RadiusCard}"
                                Margin="{DynamicResource Hub.ShadowOffset}" Visibility="{DynamicResource Hub.ShadowVisibility}"/>
                        <Border x:Name="Bd" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Line}"
                                BorderThickness="{DynamicResource Hub.CardBorder}" CornerRadius="{DynamicResource Hub.RadiusCard}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Border x:Name="Sel" BorderBrush="{DynamicResource Hub.Selection}" BorderThickness="{DynamicResource Hub.SelectionBorder}"
                                CornerRadius="{DynamicResource Hub.RadiusCard}" Visibility="Hidden" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Margin" Value="0,2,0,-2"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ================= Standard controls in the theme's look (implicit: they apply everywhere, dialogs too) ================= -->
    <CornerRadius x:Key="Hub.RadiusCheck">4</CornerRadius>

    <!-- text field -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Hub.Selection}"/>
        <Setter Property="Background" Value="{DynamicResource Hub.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.LineStrong}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource Hub.RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/> <!-- the TextBox applies its Padding itself -->
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- dropdown (also the editable one of the Nuzlocke tracker) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource Hub.RadiusInner}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.HoverOverlay}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.ChipOn}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.ChipOnInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,5,30,5"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root">
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.LineStrong}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Hub.RadiusControl}">
                                        <Path Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource Hub.InkMuted}" StrokeThickness="1.8" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,1,11,0" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Hidden" Margin="8,0,28,0" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource Hub.Ink}"
                                 FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" IsReadOnly="{TemplateBinding IsReadOnly}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0" Padding="3"
                                    Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.LineStrong}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Hub.RadiusInner}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Shown" Property="Visibility" Value="Hidden"/>
                            <Setter Property="Cursor" Value="IBeam"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tick box -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" VerticalAlignment="Center" BorderThickness="1.5" CornerRadius="{DynamicResource Hub.RadiusCheck}"
                                BorderBrush="{DynamicResource Hub.LineStrong}" Background="{DynamicResource Hub.Surface}">
                            <Path x:Name="Tick" Data="M3,8.5 L6.8,12.3 L14,4.5" Stroke="{DynamicResource Hub.AccentInk}" StrokeThickness="2.2" Visibility="Hidden"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Hub.Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Hub.AccentEdge}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- fold-out section (log, spoiler, expert options) -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkMuted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Hub.FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="Header" DockPanel.Dock="Top" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" Padding="2,5" CornerRadius="{DynamicResource Hub.RadiusControl}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Arrow" Data="M0,0 L4.5,4.5 L0,9" Stroke="{DynamicResource Hub.InkMuted}" StrokeThickness="1.8"
                                                  VerticalAlignment="Center" Margin="2,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="Turn"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.HoverOverlay}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the ✗ of the Nuzlocke tracker: a key that turns into a red "struck" mark -->
    <Style x:Key="Hub.Strike" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Hub.KeyInk}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource Hub.KeyFace}" BorderBrush="{DynamicResource Hub.KeyLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource Hub.RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Hub.Selection}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hub.DangerFace}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Hub.DangerEdge}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Hub.DangerInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- progress bars: a slot in the theme's colours; "busy" (indeterminate) = a light sweeping through -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource Hub.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Hub.SlotFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Hub.Line}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                            <Border x:Name="Sweep" Width="36" HorizontalAlignment="Left" CornerRadius="2" Visibility="Collapsed" Background="{TemplateBinding Foreground}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="SweepMove" X="-36"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SweepRun">
                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                        <DoubleAnimation Storyboard.TargetName="SweepMove" Storyboard.TargetProperty="X" From="-36" To="160" Duration="0:0:1.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SweepRun"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- column headers of lists (import): small caps labels on the panel, a thin line below -->
    <Style x:Key="Hub.ColumnHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource Hub.InkMuted}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border BorderBrush="{DynamicResource Hub.Line}" BorderThickness="0,0,0,1" Background="Transparent" Padding="8,6,8,6">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{DynamicResource Hub.Label}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MonHub's title bar buttons (main window and dialogs): the theme's ink, a soft tint on hover -->
        <!-- title bar buttons: the theme's ink, a soft tint on hover (Tag="hover" = pointed at, reported by Windows) -->
        <Style x:Key="Chrome.Button" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Hub.Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Tint" Background="{TemplateBinding Foreground}" Opacity="0"/>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="hover">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.24"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="pressed">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- close: Windows' red on hover -->
        <Style x:Key="Chrome.Close" TargetType="Button" BasedOn="{StaticResource Chrome.Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Tint" Background="#C42B1C" Opacity="0"/>
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="1"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    <!--
        Every MonHub dialog (import, help, settings …) gets MonHub's own title bar like the main window: the title on the
        left, a close button on the right, drag to move – in the theme's colours instead of Windows' white bar.
        Style="{StaticResource Hub.DialogWindow}" on the window; the close command is bound for all windows in App.
    -->
    <Style x:Key="Hub.DialogWindow" TargetType="Window">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="34">
                                <TextBlock Text="{TemplateBinding Title}" Margin="16,0,60,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Hub.Ink}" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Chrome.Close}" Content="&#xE8BB;"
                                        Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="{local:L 'Schließen', 'Close'}"/>
                            </Grid>
                            <AdornerDecorator>
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- fixed-size dialogs: no resize border to grab -->
            <Trigger Property="ResizeMode" Value="NoResize">
                <Setter Property="WindowChrome.WindowChrome">
                    <Setter.Value>
                        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>