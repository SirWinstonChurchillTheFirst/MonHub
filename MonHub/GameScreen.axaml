<UserControl x:Class="MonHub.GameScreen"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonHub">
    <!--
        The running game inside MonHub: a bar in the theme's colours and fonts with the game's name and its buttons, below
        it the emulator's own window – exactly as big as its picture needs, on the theme's own background (no black bars).
    -->
    <UserControl.Resources>
        <StreamGeometry x:Key="Glyph.Screens">M1.5,3.5 H7 V12.5 H1.5 Z M9,3.5 H14.5 V12.5 H9 Z</StreamGeometry>
        <StreamGeometry x:Key="Glyph.Menu">M1,3 H15 M1,8 H15 M1,13 H15</StreamGeometry>
        <StreamGeometry x:Key="Glyph.Full">M1,6 V1 H6 M10,1 H15 V6 M15,10 V15 H10 M6,15 H1 V10</StreamGeometry>
        <StreamGeometry x:Key="Glyph.FullExit">M6,1 V6 H1 M15,6 H10 V1 M10,15 V10 H15 M1,10 H6 V15</StreamGeometry>
        <StreamGeometry x:Key="Glyph.Own">M9,1 H15 V7 M15,1 L7.5,8.5 M6,3 H1 V15 H13 V10</StreamGeometry>
        <StreamGeometry x:Key="Glyph.Quit">M8,1 V7.5 M4.2,3.4 A6,6 0 1 0 11.8,3.4</StreamGeometry>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- a line icon in the button's ink -->
        <Style Selector="Path.glyph">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
        </Style>
        <Style Selector="Button.bar">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.bar TextBlock">
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- narrow: only the icons (the tooltips say what they do) -->
        <Style Selector="Button.bar.narrow TextBlock">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Background="Transparent">
        <Border x:Name="Bar" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Line}" BorderThickness="0,0,0,1"
                CornerRadius="{DynamicResource Hub.RadiusInner}" Padding="10,7,4,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMenu" Classes="bar" Theme="{DynamicResource Hub.Key}" Click="Menu_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="glyph" Data="{StaticResource Glyph.Menu}"/>
                            <TextBlock x:Name="TxtMenu"/>
                        </StackPanel>
                    </Button>
                    <!-- DS and 3DS: how the two screens are arranged (the emulator starts again for it) -->
                    <Button x:Name="BtnScreens" Classes="bar" Theme="{DynamicResource Hub.Key}" IsVisible="False"
                            ToolTip.Tip="{local:L 'Bildschirm-Anordnung', 'Screen arrangement'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="glyph" Data="{StaticResource Glyph.Screens}"/>
                            <TextBlock Text="{local:L 'Anordnung', 'Screens'}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFull" Classes="bar" Theme="{DynamicResource Hub.Key}" Click="Full_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="GlyphFull" Classes="glyph" Data="{StaticResource Glyph.Full}"/>
                            <TextBlock x:Name="TxtFull"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOwn" Classes="bar" Theme="{DynamicResource Hub.Key}" Click="Own_Click"
                            ToolTip.Tip="{local:L 'Im eigenen Fenster – das Spiel läuft weiter, im Fenster des Emulators wie früher.', 'In its own window – the game keeps running, in the emulator’s own window like before.'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="glyph" Data="{StaticResource Glyph.Own}"/>
                            <TextBlock Text="{local:L 'Eigenes Fenster', 'Own window'}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnQuit" Classes="bar" Theme="{DynamicResource Hub.DangerKey}" Click="Quit_Click"
                            ToolTip.Tip="{local:L 'Spiel beenden', 'Quit the game'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Classes="glyph" Data="{StaticResource Glyph.Quit}"/>
                            <TextBlock Text="{local:L 'Beenden', 'Quit'}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <local:SpriteView Key="icon/play" Width="32" Height="32" Margin="-2,-6,8,-6" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtTitle" Classes="heading" FontSize="15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border Background="{DynamicResource Hub.ChipOn}" CornerRadius="{DynamicResource Hub.RadiusChip}" Padding="7,1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEmulator" FontFamily="{DynamicResource Hub.FontLabel}" FontSize="{DynamicResource Hub.SizeTag}"
                                       Foreground="{DynamicResource Hub.ChipOnInk}"/>
                        </Border>
                        <TextBlock x:Name="TxtNote" Classes="muted" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- while the emulator starts: the game's own Pokémon on the theme's background (the emulator's place above it is
             invisible until the game is ready) -->
        <StackPanel x:Name="Loading" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
            <local:SpriteView x:Name="LoadingSprite" Key="0025/idle" Height="112" MaxWidth="160" Stretch="Uniform" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtLoading" Classes="heading" HorizontalAlignment="Center" Margin="0,14,0,4" TextAlignment="Center"/>
            <TextBlock x:Name="TxtLoadingNote" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
        <local:GameHost x:Name="Host" Grid.Row="1" IsVisible="False" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
