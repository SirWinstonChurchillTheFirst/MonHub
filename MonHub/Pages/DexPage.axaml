<UserControl x:Class="MonHub.DexPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonHub">
    <!--
        The Dex of one save, read straight from it: every Pokémon the game knows, by national number – caught ones
        with their sprite and a check mark, seen ones faded, unknown ones as "?".
        Performance: rows of cells in a virtualizing list (only the visible rows exist), sprites stand still.
    -->
    <Grid Margin="30,8,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header: title + search -->
        <DockPanel>
            <Grid DockPanel.Dock="Right" Width="230" VerticalAlignment="Bottom" Margin="16,0,0,4">
                <TextBox x:Name="TxtSearch" Theme="{DynamicResource Hub.Search}" TextChanged="Search_TextChanged"/>
                <Path Data="M6,0.75 A5.25,5.25 0 1 1 5.99,0.75 M9.8,9.8 L13.5,13.5" Stroke="{DynamicResource Hub.InkMuted}" StrokeThickness="1.5"
                      StrokeLineCap="Round" Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="{local:L 'Name oder Nummer …', 'Name or number …'}" Margin="31,0,0,0" VerticalAlignment="Center"
                           Classes="muted" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel>
                <TextBlock Text="DEX" Classes="label"/>
                <TextBlock Text="Dex" Classes="title" Margin="0,4,0,2"/>
                <TextBlock x:Name="TxtSummary" Classes="muted" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- which save, which Pokémon -->
        <WrapPanel x:Name="FilterBar" Grid.Row="1" Margin="0,16,0,4">
            <ComboBox x:Name="CmbSave" MinWidth="260" MaxWidth="400" Margin="0,0,14,8" SelectionChanged="Save_Changed"
                      ToolTip.Tip="{local:L 'Wessen Dex – jeder Spielstand hat seinen eigenen', 'Whose Dex – every save has its own'}"/>
            <RadioButton x:Name="FilterAll" Theme="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" IsChecked="True" IsCheckedChanged="Filter_Changed">
                <TextBlock x:Name="TxtFilterAll" Text="{local:L 'Alle', 'All'}"/>
            </RadioButton>
            <RadioButton x:Name="FilterCaught" Theme="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" IsCheckedChanged="Filter_Changed">
                <TextBlock x:Name="TxtFilterCaught" Text="{local:L 'Gefangen', 'Caught'}"/>
            </RadioButton>
            <RadioButton x:Name="FilterSeen" Theme="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" IsCheckedChanged="Filter_Changed">
                <TextBlock x:Name="TxtFilterSeen" Text="{local:L 'Nur gesehen', 'Seen only'}"/>
            </RadioButton>
            <RadioButton x:Name="FilterMissing" Theme="{DynamicResource Hub.Chip}" GroupName="DexFilter" Margin="0,0,6,8" IsCheckedChanged="Filter_Changed">
                <TextBlock x:Name="TxtFilterMissing" Text="{local:L 'Fehlen', 'Missing'}"/>
            </RadioButton>
        </WrapPanel>

        <!-- how far: caught of all -->
        <Grid x:Name="ProgressRow" Grid.Row="2" Margin="0,2,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" VerticalAlignment="Center" Maximum="1"/>
            <TextBlock x:Name="TxtProgress" Grid.Column="1" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <ListBox x:Name="DexRows" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False" ItemContainerTheme="{DynamicResource Hub.PlainItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SizeChanged="Rows_SizeChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="local:DexCell">
                                <Border Classes="slot" Width="{x:Static local:DexCell.Width}" Height="{x:Static local:DexCell.Height}"
                                        Margin="0,0,8,8" ToolTip.Tip="{Binding Tooltip}" Opacity="{Binding Fade}">
                                    <Grid>
                                        <TextBlock Text="{Binding NumberText}" Margin="7,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   FontFamily="{DynamicResource Hub.FontLabel}" FontSize="10" Foreground="{DynamicResource Hub.InkMuted}"/>
                                        <local:SpriteView Key="icon/check" Width="16" Height="16" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Still="True" IsVisible="{Binding BallVisibility}"/>
                                        <!-- the game sprites are small: shown 1.6× with hard pixels -->
                                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,16">
                                            <LayoutTransformControl.LayoutTransform>
                                                <ScaleTransform ScaleX="1.6" ScaleY="1.6"/>
                                            </LayoutTransformControl.LayoutTransform>
                                            <local:SpriteView Key="{Binding Sprite}" Still="True" MaxWidth="52" MaxHeight="40" Stretch="Uniform" StretchDirection="DownOnly"
                                                              RenderOptions.BitmapInterpolationMode="None"/>
                                        </LayoutTransformControl>
                                        <TextBlock Text="?" IsVisible="{Binding UnknownVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,14"
                                                   FontFamily="{DynamicResource Hub.FontLabel}" FontSize="26" Foreground="{DynamicResource Hub.InkMuted}"/>
                                        <TextBlock Text="{Binding Name}" Margin="4,0,4,5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                   FontSize="11.5" Foreground="{DynamicResource Hub.Ink}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- nothing to show -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" IsVisible="False">
            <local:SpriteView Key="species/0137" Height="64" Decorative="True" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtEmpty" Classes="body" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
