<local:HubWindow x:Class="RandoApp.NameDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MonHub"
        Title="{local:L 'Name für den Run', 'Name for the run'}" Theme="{StaticResource Hub.DialogWindow}" Width="560" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource Hub.Dialog}" Icon="{StaticResource AppIconImage}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="{local:L 'Wie soll der neue Run heißen?', 'What should the new run be called?'}" Classes="heading" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtName" TextChanged="TxtName_TextChanged" KeyDown="TxtName_KeyDown"/>
        <TextBlock x:Name="TxtError" Foreground="{DynamicResource Hub.Danger}" Margin="0,6,0,0" TextWrapping="Wrap" MinHeight="18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{local:L 'Automatischen Namen behalten', 'Keep the automatic name'}" Click="BtnCancel_Click" Theme="{DynamicResource Hub.Ghost}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="BtnOk" Content="{local:L 'Übernehmen', 'OK'}" Click="BtnOk_Click" Theme="{DynamicResource Hub.PrimaryKey}"/>
        </StackPanel>
    </StackPanel>
</local:HubWindow>
