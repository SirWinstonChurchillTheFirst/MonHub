<local:HubWindow x:Class="MonHub.ImportWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MonHub"
        Title="{local:L 'Importieren', 'Import'}" Theme="{StaticResource Hub.DialogWindow}" Width="900" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Hub.Dialog}"
        Icon="{StaticResource AppIconImage}">
    <DockPanel Margin="26,20,26,20">
        <!-- header -->
        <DockPanel DockPanel.Dock="Top">
            <local:SpriteView Key="icon/import" DockPanel.Dock="Left" Width="32" Height="32" VerticalAlignment="Top" Margin="0,4,12,0"/>
            <StackPanel>
                <TextBlock Text="IMPORT" Classes="label"/>
                <TextBlock Text="{local:L 'Vom alten Emulator holen', 'Bring over from your old emulator'}" Classes="title" Margin="0,4,0,2"/>
                <TextBlock Classes="muted"
                           Text="{local:L 'Übernimm ROMs und Spielstände von deinem bisherigen Emulator. Es wird nur kopiert – deine Originaldateien bleiben unverändert, und im MonHub wird nichts überschrieben.', 'Take over ROMs and saves from the emulator you used so far. Everything is only copied – your original files stay untouched, and nothing in MonHub is overwritten.'}"/>
            </StackPanel>
        </DockPanel>

        <!-- bottom: result + buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Theme="{DynamicResource Hub.Ghost}" IsCancel="True" Margin="0,0,10,0" VerticalAlignment="Center" Click="Close_Click" Content="{local:L 'Schließen', 'Close'}"></Button>
                <Button x:Name="BtnImport" Theme="{DynamicResource Hub.PrimaryKey}" Click="Import_Click">
                    <TextBlock x:Name="TxtImportButton" Text="{local:L 'Importieren', 'Import'}"/>
                </Button>
            </StackPanel>
            <!-- while copying the die wobbles, when done it settles -->
            <local:SpriteView x:Name="Ball" Key="icon/dice" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,10,0"
                              VerticalAlignment="Center" RenderTransformOrigin="50%,80%" IsVisible="False"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock x:Name="TxtResult" Classes="body" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ImportProgress" Height="6" Margin="0,6,0,0" IsVisible="False"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- sources -->
            <DockPanel Margin="0,18,0,6">
                <Button DockPanel.Dock="Right" Theme="{DynamicResource Hub.Key}" Click="AddFolder_Click" Content="{local:L 'Ordner hinzufügen …', 'Add folder …'}"></Button>
                <TextBlock Text="{local:L 'WOHER?', 'FROM WHERE?'}" Classes="label" VerticalAlignment="Center"/>
            </DockPanel>
            <ContentControl Grid.Row="1" Theme="{DynamicResource Hub.Inset}" MinHeight="54">
                <Grid>
                    <StackPanel x:Name="SearchingPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:L 'Suche nach Emulatoren auf diesem PC …', 'Looking for emulators on this PC …'}" Classes="muted" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtNoSources" IsVisible="False" VerticalAlignment="Center" Classes="muted"
                               Text="{local:L 'Kein Emulator automatisch gefunden. Wähle mit „Ordner hinzufügen …“ den Ordner deines Emulators oder deiner ROMs.', 'No emulator found automatically. Use “Add folder …” to choose the folder of your emulator or your ROMs.'}"/>
                    <ItemsControl x:Name="SourceList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" IsCheckedChanged="Source_Toggled" Margin="0,3" Foreground="{DynamicResource Hub.Ink}">
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Hub.Ink}">
                                        <Run Text="{Binding Source.Label, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text="{Binding Source.Folder, Mode=OneWay}" Foreground="{DynamicResource Hub.InkMuted}"/>
                                        <Run Text="{Binding ExtraText, Mode=OneWay}" Foreground="{DynamicResource Hub.InkMuted}" FontStyle="Italic"/>
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ContentControl>

            <!-- found files -->
            <DockPanel Grid.Row="2" Margin="0,18,0,6">
                <TextBlock x:Name="TxtSummary" DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Center"/>
                <TextBlock Text="{local:L 'GEFUNDEN', 'FOUND'}" Classes="label" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Grid.Row="3" Background="{DynamicResource Hub.Surface}" BorderBrush="{DynamicResource Hub.Line}" BorderThickness="1"
                    CornerRadius="{DynamicResource Hub.RadiusInner}" Padding="2">
                <!-- a table: small caps column labels on the panel, a thin line below, one row per file -->
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Hub.Line}" BorderThickness="0,0,0,1" Padding="8,6">
                        <Grid ColumnDefinitions="36,160,*,80,180">
                            <TextBlock Grid.Column="1" Text="{local:L 'Art', 'Type'}" Classes="label"/>
                            <TextBlock Grid.Column="2" Text="{local:L 'Datei', 'File'}" Classes="label"/>
                            <TextBlock Grid.Column="3" Text="{local:L 'Größe', 'Size'}" Classes="label"/>
                            <TextBlock Grid.Column="4" Text="Status" Classes="label"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="ItemList" ItemContainerTheme="{DynamicResource Hub.PlainItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="36,160,*,80,180" Margin="8,4">
                                    <CheckBox IsChecked="{Binding Selected}" IsCheckedChanged="Item_Toggled" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" Classes="body" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Classes="body" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="body" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Status}" Classes="body" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</local:HubWindow>
