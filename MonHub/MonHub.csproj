<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- one code base for Windows and Linux: the UI is Avalonia -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MonHub</AssemblyName>
    <!-- names Windows shows (Task Manager, "Open with" …) -->
    <AssemblyTitle>MonHub</AssemblyTitle>
    <Product>MonHub</Product>
    <Version>2.9.1</Version>
    <RootNamespace>MonHub</RootNamespace>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <ApplicationIcon>monhub.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows-only calls are guarded by OperatingSystem.IsWindows() at their call sites -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!-- program icons of fangames (Windows only) -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools: generators and labs, not part of the app -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- SafeFile, sprites and the randomizer classes (Rando\, Shared\) keep their RandoApp namespace -->
    <Using Include="RandoApp" />
    <InternalsVisibleTo Include="MonHub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- every Pokémon up to Gen 7, the menu icons and the animated sprites (PMD Sprite Collab, CC BY-NC 4.0), pixel fonts
         (SIL OFL), the tour guide's faces, the Nuzlocke route lists; all built by tools/*.py -->
    <AvaloniaResource Include="Assets\Species\*.png" />
    <AvaloniaResource Include="Assets\Icons\*.png" />
    <AvaloniaResource Include="Assets\Sprites\*.png" />
    <AvaloniaResource Include="Assets\Portraits\*.png" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Nuzlocke\routes.json" />
  </ItemGroup>

  <!-- "Neuer Run" (Rando\*): the randomizer helper (java\RandoHelper.java, built by installer\build.ps1) -->
  <ItemGroup>
    <None Include="java\RandoHelper.jar" Link="RandoHelper.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
